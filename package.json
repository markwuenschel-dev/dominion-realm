{
  "name": "dominion-realm",
  "type": "module",
  "version": "2.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": "9.15.9"
  },
  "scripts": {
    "predev": "node scripts/copy-content-media.mjs && tsx scripts/generate-downloads.ts && tsx scripts/generate-content-manifest.ts",
    "dev": "next dev",
    "prebuild": "node scripts/copy-content-media.mjs && tsx scripts/generate-downloads.ts && tsx scripts/generate-content-manifest.ts",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint -D correctness -D suspicious -A react-in-jsx-scope -A vitest/no-conditional-expect --react-plugin --nextjs-plugin --react-perf-plugin --vitest-plugin src scripts",
    "check": "tsc --noEmit",
    "scene:check": "tsx scripts/check-scene-joins.ts",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@keystatic/core": "^0.5.50",
    "@keystatic/next": "^5.0.4",
    "@mdx-js/loader": "^3.1.0",
    "@mdx-js/react": "^3.1.0",
    "@next/mdx": "^16.2.10",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@sanity/client": "^7",
    "@sanity/image-url": "^2.1.1",
    "@sanity/vision": "^6.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fast-glob": "^3.3.3",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.511.0",
    "minisearch": "^7.1.2",
    "next": "^16.2.10",
    "next-mdx-remote": "^6.0.0",
    "next-sanity": "^13.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sanity": "^6.4.0",
    "styled-components": "^6.1",
    "tailwind-merge": "^3.2.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.8",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/mdx": "^2.0.13",
    "@types/node": "^22.10.7",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "jszip": "^3.10.1",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.71.0",
    "pa11y-ci": "^4.0.0",
    "pdfkit": "^0.15.2",
    "tailwindcss": "^4.1.8",
    "tsx": "4",
    "typescript": "^5.7.3",
    "vitest": "^4.1.9",
    "wait-on": "^8.0.3"
  }
}
