{
  "name": "dominion-realm",
  "type": "module",
  "version": "2.0.0",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11"
  },
  "scripts": {
    "predev": "node scripts/copy-content-media.mjs && tsx scripts/generate-downloads.ts && tsx scripts/generate-content-manifest.ts",
    "dev": "next dev",
    "prebuild": "node scripts/copy-content-media.mjs && tsx scripts/generate-downloads.ts && tsx scripts/generate-content-manifest.ts",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint -D correctness -D suspicious -A react-in-jsx-scope -A vitest/no-conditional-expect --react-plugin --nextjs-plugin --react-perf-plugin --vitest-plugin src scripts",
    "check": "tsc --noEmit",
    "scene:check": "tsx scripts/check-scene-joins.ts",
    "launch:check": "tsx scripts/launch-readiness.ts",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@keystatic/core": "^0.6.0",
    "@keystatic/next": "^5.0.4",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.2.11",
    "@radix-ui/react-label": "^2.1.12",
    "@radix-ui/react-select": "^2.3.4",
    "@radix-ui/react-separator": "^1.1.12",
    "@radix-ui/react-slider": "^1.4.4",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.18",
    "@radix-ui/react-tooltip": "^1.2.13",
    "@sanity/client": "^7.24.0",
    "@sanity/image-url": "^2.1.1",
    "@sanity/vision": "^6.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fast-glob": "^3.3.3",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.25.0",
    "minisearch": "^7.2.0",
    "next": "^16.2.11",
    "next-mdx-remote": "^6.0.0",
    "next-sanity": "^13.1.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sanity": "^6.6.0",
    "styled-components": "^6.4.4",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.1.1",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^29.1.1",
    "jszip": "^3.10.1",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "pa11y-ci": "^4.1.1",
    "pdfkit": "^0.19.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "wait-on": "^9.1.0"
  }
}
