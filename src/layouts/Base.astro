---
import { Font } from 'astro:assets';
import Analytics from '../components/Analytics.astro';
import '../styles/global.css';

const DEFAULT_DESC =
  "An Earth gamer's cybernetic implant translates a real metaphysical world into RPG logic — until he realizes the interface is not the world. It is only his way of surviving contact with it.";

interface Props {
  title?: string;
  description?: string;
  /** OG/Twitter title; falls back to the short brand name. */
  ogTitle?: string;
}

const base = import.meta.env.BASE_URL;
const {
  title = 'The Dominion Realm — An Interface Fantasy Novel',
  description = DEFAULT_DESC,
  ogTitle = 'The Dominion Realm',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-body" preload />
    <Font cssVariable="--font-mono" />
  </head>
  <body>
    <slot />
    <Analytics />
  </body>
</html>
