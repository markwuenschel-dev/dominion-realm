---
/**
 * The Constellation — a character/world relationship map (backlog Phase 3 #7).
 * Built entirely from the existing `relationships` frontmatter via the codex
 * helpers: no new content, no new deps (ADR-0008). The layout is computed
 * server-side (hub-centered radial) and emitted as static SVG; a small inline
 * script lights a node's threads on hover/focus, and a textual index below is
 * the no-JS / screen-reader fallback.
 */
import CodexLayout from '../layouts/CodexLayout.astro';
import {
  getAllCodexEntries,
  codexUrl,
  COLLECTION_LABELS,
  COLLECTION_ORDER,
  type CodexEntry,
} from '../lib/codex';

const base = import.meta.env.BASE_URL;
const all = await getAllCodexEntries();
const byId = new Map(all.map((e) => [e.id, e]));

// ---- Build undirected, de-duplicated edges from every entry's relationships.
interface Edge {
  a: string;
  b: string;
  labels: string[];
}
const edgeMap = new Map<string, Edge>();
for (const e of all) {
  for (const rel of e.data.relationships) {
    const target = byId.get(rel.entry);
    if (!target || target.id === e.id) continue;
    if (rel.collection && target.collection !== rel.collection) continue;
    const [a, b] = [e.id, target.id].sort();
    const key = `${a}|${b}`;
    const existing = edgeMap.get(key);
    if (existing) {
      if (rel.label && !existing.labels.includes(rel.label)) existing.labels.push(rel.label);
    } else {
      edgeMap.set(key, { a, b, labels: rel.label ? [rel.label] : [] });
    }
  }
}
const edges = [...edgeMap.values()];

// ---- Degree drives node size and picks the hub (the protagonist, in practice).
const degree = new Map<string, number>();
for (const e of edges) {
  degree.set(e.a, (degree.get(e.a) ?? 0) + 1);
  degree.set(e.b, (degree.get(e.b) ?? 0) + 1);
}
const nodeEntries = all.filter((e) => degree.has(e.id));
const hub = nodeEntries.reduce(
  (best, n) => ((degree.get(n.id) ?? 0) > (degree.get(best.id) ?? 0) ? n : best),
  nodeEntries[0],
);

// ---- Radial layout: hub at center, everyone else on a ring grouped by
//      collection so same-type nodes cluster and chords stay short.
const collIndex = (e: CodexEntry) => COLLECTION_ORDER.indexOf(e.collection);
const ring = nodeEntries
  .filter((n) => n.id !== hub.id)
  .sort((a, b) => collIndex(a) - collIndex(b) || a.data.name.localeCompare(b.data.name));

const CENTER = 500;
const R = 350;
interface Point {
  x: number;
  y: number;
  onRing: boolean;
}
const pos = new Map<string, Point>();
pos.set(hub.id, { x: CENTER, y: CENTER, onRing: false });
ring.forEach((n, i) => {
  const angle = (i / ring.length) * Math.PI * 2 - Math.PI / 2;
  pos.set(n.id, { x: CENTER + Math.cos(angle) * R, y: CENTER + Math.sin(angle) * R, onRing: true });
});

const COLLECTION_COLOR: Record<string, string> = {
  characters: '#e3c486',
  concepts: '#4fd6e0',
  factions: '#ef6f9e',
  places: '#9b6cf0',
};

const nodeRadius = (id: string) => Math.min(30, 9 + (degree.get(id) ?? 1) * 1.8);

/** Place a node's label clear of its dot, pushed outward from the centre. */
function labelFor(p: Point, r: number) {
  if (!p.onRing) return { x: p.x, y: p.y + r + 26, anchor: 'middle', baseline: 'hanging' };
  const dx = p.x - CENTER;
  if (Math.abs(dx) < 70) {
    const below = p.y >= CENTER;
    return {
      x: p.x,
      y: p.y + (below ? r + 22 : -(r + 14)),
      anchor: 'middle',
      baseline: below ? 'hanging' : 'auto',
    };
  }
  const right = dx > 0;
  return {
    x: p.x + (right ? r + 9 : -(r + 9)),
    y: p.y,
    anchor: right ? 'start' : 'end',
    baseline: 'middle',
  };
}

// ---- Textual index (no-JS / a11y fallback): each node and its threads.
const threadIndex = nodeEntries
  .map((n) => ({
    node: n,
    conns: edges
      .filter((e) => e.a === n.id || e.b === n.id)
      .map((e) => ({ entry: byId.get(e.a === n.id ? e.b : e.a)!, labels: e.labels }))
      .sort((x, y) => x.entry.data.name.localeCompare(y.entry.data.name)),
  }))
  .sort(
    (a, b) =>
      collIndex(a.node) - collIndex(b.node) || a.node.data.name.localeCompare(b.node.data.name),
  );

const legend = COLLECTION_ORDER.filter((c) => nodeEntries.some((n) => n.collection === c));
---

<CodexLayout
  title="The Constellation"
  description="A relationship map of The Dominion Realm — how the cast, the powers, the factions, and the places of the Realm pull on one another."
>
  <div class="codex-head">
    <span class="codex-head__label">The Constellation</span>
    <h1 class="codex-head__title">Every thread, <em>at once</em></h1>
    <p class="codex-head__intro">
      One substrate, many interfaces — and many ties. This is the whole codex drawn as a single
      figure: each point is an entry, each line a relationship it declares. Hover a point to light
      its threads, or follow one to its page.
    </p>
    <div class="codex-rule"></div>
  </div>

  <div class="rel-legend">
    {
      legend.map((c) => (
        <span class="rel-legend__item">
          <span class="rel-legend__dot" style={`--c:${COLLECTION_COLOR[c]}`} />
          {COLLECTION_LABELS[c]}
        </span>
      ))
    }
  </div>

  <div class="constellation-wrap">
    <svg
      class="constellation"
      viewBox="0 0 1000 1000"
      role="img"
      aria-label="Relationship map of The Dominion Realm's codex entries"
    >
      <g class="edges">
        {
          edges.map((e) => {
            const a = pos.get(e.a)!;
            const b = pos.get(e.b)!;
            return (
              <line class="edge" data-a={e.a} data-b={e.b} x1={a.x} y1={a.y} x2={b.x} y2={b.y}>
                <title>
                  {e.labels.join(' · ') ||
                    `${byId.get(e.a)!.data.name} — ${byId.get(e.b)!.data.name}`}
                </title>
              </line>
            );
          })
        }
      </g>
      <g class="nodes">
        {
          nodeEntries.map((n) => {
            const p = pos.get(n.id)!;
            const r = nodeRadius(n.id);
            const lab = labelFor(p, r);
            return (
              <a
                class:list={['node', { 'node--hub': n.id === hub.id }]}
                href={codexUrl(base, n.collection, n.id)}
                data-id={n.id}
                style={`--c:${COLLECTION_COLOR[n.collection]}`}
              >
                <title>
                  {n.data.name} · {COLLECTION_LABELS[n.collection]}
                </title>
                <circle class="node-dot" cx={p.x} cy={p.y} r={r} />
                <text
                  class="node-label"
                  x={lab.x}
                  y={lab.y}
                  text-anchor={lab.anchor}
                  dominant-baseline={lab.baseline}
                >
                  {n.data.name}
                </text>
              </a>
            );
          })
        }
      </g>
    </svg>
  </div>

  <section class="rel-index" aria-label="Relationships in words">
    <h2 class="rel-index__title">Every thread, in words</h2>
    <div class="rel-index__grid">
      {
        threadIndex.map(({ node, conns }) => (
          <div class="rel-row">
            <a
              class="rel-row__name"
              href={codexUrl(base, node.collection, node.id)}
              style={`--c:${COLLECTION_COLOR[node.collection]}`}
            >
              {node.data.name}
            </a>
            <span class="rel-row__kind">{COLLECTION_LABELS[node.collection]}</span>
            <div class="rel-row__conns">
              {conns.map((c) => (
                <a class="rel-chip" href={codexUrl(base, c.entry.collection, c.entry.id)}>
                  {c.labels.length > 0 && <span class="rel-chip__rel">{c.labels.join(' · ')}</span>}
                  {c.entry.data.name}
                </a>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <a class="codex-back" href={`${base}codex`}>← All entries</a>
</CodexLayout>

<style>
  /* ---- Legend ---- */
  .rel-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 26px;
    margin-bottom: clamp(20px, 4vw, 36px);
  }
  .rel-legend__item {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-family: var(--mono);
    font-size: 0.62rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-dim);
  }
  .rel-legend__dot {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--c);
    box-shadow: 0 0 10px -1px var(--c);
  }

  /* ---- The constellation figure ---- */
  .constellation-wrap {
    max-width: 820px;
    margin: 0 auto clamp(40px, 7vw, 72px);
    padding: clamp(28px, 6vw, 64px);
  }
  .constellation {
    width: 100%;
    height: auto;
    overflow: visible;
    display: block;
  }

  .edge {
    stroke: rgba(200, 168, 106, 0.16);
    stroke-width: 1.4;
    transition:
      stroke 0.4s var(--ease),
      stroke-width 0.4s var(--ease),
      opacity 0.4s var(--ease);
  }
  .constellation.focused .edge {
    opacity: 0.25;
  }
  .edge.is-lit {
    stroke: var(--gold-bright);
    stroke-width: 2;
    opacity: 1;
  }

  .node {
    cursor: pointer;
  }
  .node-dot {
    fill: var(--c);
    stroke: var(--bg);
    stroke-width: 2;
    filter: drop-shadow(0 0 6px color-mix(in srgb, var(--c) 60%, transparent));
    transition:
      r 0.35s var(--ease),
      filter 0.35s var(--ease),
      opacity 0.35s var(--ease);
  }
  .node--hub .node-dot {
    stroke: var(--gold);
    filter: drop-shadow(0 0 14px color-mix(in srgb, var(--c) 80%, transparent));
  }
  .node-label {
    fill: var(--ink-dim);
    font-family: var(--mono);
    font-size: 20px;
    letter-spacing: 0.04em;
    pointer-events: none;
    transition:
      fill 0.35s var(--ease),
      opacity 0.35s var(--ease);
  }
  .node--hub .node-label {
    fill: var(--ink);
    font-size: 23px;
  }
  .node:hover .node-dot,
  .node:focus-visible .node-dot {
    filter: drop-shadow(0 0 16px var(--c));
  }
  .node:hover .node-label,
  .node:focus-visible .node-label {
    fill: var(--gold-bright);
  }
  .node:focus-visible {
    outline: none;
  }

  /* Hover/focus dimming, driven by the inline script. */
  .node.is-dim .node-dot {
    opacity: 0.22;
  }
  .node.is-dim .node-label {
    opacity: 0.2;
  }
  .node.is-active .node-label,
  .node.is-neighbor .node-label {
    fill: var(--ink);
  }
  .node.is-active .node-dot {
    filter: drop-shadow(0 0 18px var(--c));
  }

  /* ---- Textual thread index (no-JS / a11y fallback) ---- */
  .rel-index {
    border-top: 1px solid var(--line-soft);
    padding-top: clamp(28px, 5vw, 44px);
  }
  .rel-index__title {
    font-family: var(--serif-display);
    font-weight: 500;
    font-size: clamp(1.5rem, 3vw, 2rem);
    color: var(--ink);
    margin-bottom: clamp(20px, 4vw, 32px);
  }
  .rel-index__grid {
    display: grid;
    gap: 22px;
  }
  .rel-row {
    display: grid;
    grid-template-columns: minmax(0, 200px) 1fr;
    gap: 6px 22px;
    align-items: baseline;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--line-soft);
  }
  .rel-row:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }
  .rel-row__name {
    font-family: var(--serif-display);
    font-size: 1.2rem;
    color: var(--c);
    text-decoration: none;
    line-height: 1.2;
    grid-row: span 2;
  }
  .rel-row__name:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .rel-row__kind {
    grid-column: 2;
    font-family: var(--mono);
    font-size: 0.56rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .rel-row__conns {
    grid-column: 2;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .rel-chip {
    display: inline-flex;
    align-items: baseline;
    gap: 7px;
    padding: 5px 11px;
    background: var(--bg-panel);
    border: 1px solid var(--line-soft);
    border-radius: 999px;
    font-size: 0.82rem;
    color: var(--ink-dim);
    text-decoration: none;
    transition:
      border-color 0.35s var(--ease),
      color 0.35s var(--ease);
  }
  .rel-chip:hover {
    border-color: var(--line);
    color: var(--ink);
  }
  .rel-chip__rel {
    font-family: var(--mono);
    font-size: 0.56rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--gold);
  }

  @media (max-width: 560px) {
    .node-label {
      font-size: 24px;
    }
    .node--hub .node-label {
      font-size: 27px;
    }
    .rel-row {
      grid-template-columns: 1fr;
    }
    .rel-row__name {
      grid-row: auto;
    }
    .rel-row__kind,
    .rel-row__conns {
      grid-column: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .edge,
    .node-dot,
    .node-label {
      transition: none;
    }
  }
</style>

<script is:inline>
  (() => {
    const svg = document.querySelector('.constellation');
    if (!svg) return;
    const nodes = [...svg.querySelectorAll('.node')];
    const edges = [...svg.querySelectorAll('.edge')];

    // Adjacency from the edges' data attributes.
    const adj = new Map();
    for (const ed of edges) {
      const { a, b } = ed.dataset;
      (adj.get(a) ?? adj.set(a, new Set()).get(a)).add(b);
      (adj.get(b) ?? adj.set(b, new Set()).get(b)).add(a);
    }

    function focus(id) {
      const neighbors = adj.get(id) ?? new Set();
      svg.classList.add('focused');
      for (const n of nodes) {
        const nid = n.dataset.id;
        const active = nid === id;
        const neighbor = neighbors.has(nid);
        n.classList.toggle('is-active', active);
        n.classList.toggle('is-neighbor', neighbor);
        n.classList.toggle('is-dim', !active && !neighbor);
      }
      for (const ed of edges) {
        ed.classList.toggle('is-lit', ed.dataset.a === id || ed.dataset.b === id);
      }
    }
    function clear() {
      svg.classList.remove('focused');
      for (const n of nodes) n.classList.remove('is-active', 'is-neighbor', 'is-dim');
      for (const ed of edges) ed.classList.remove('is-lit');
    }

    for (const n of nodes) {
      n.addEventListener('mouseenter', () => focus(n.dataset.id));
      n.addEventListener('mouseleave', clear);
      n.addEventListener('focus', () => focus(n.dataset.id));
      n.addEventListener('blur', clear);
    }
  })();
</script>
