---
import { Font } from 'astro:assets';
import Analytics from '../components/Analytics.astro';
import '../styles/eyes.css';
const base = import.meta.env.BASE_URL;
const desc =
  'The Eyes of Meszkhal — six stages of ocular progression onto the spectral substrate. Select a stage to read what the walker sees.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>The Eyes of Meszkhal — The Dominion Realm</title>
    <meta name="description" content={desc} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="The Eyes of Meszkhal" />
    <meta property="og:description" content={desc} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-body" preload />
    <Font cssVariable="--font-mono" />
  </head>
  <body>
    <div class="grain"></div>
    <div class="vignette"></div>

    <header class="sysbar">
      <div class="left">
        <a class="back" href={base}>← The Dominion <em style="font-style:italic">Realm</em></a>
        <span class="brand" style="opacity:.5">·</span>
        <span class="brand">The Eyes of <em>Meszkhal</em></span>
      </div>
      <div class="sys-readout">
        <span>SUBJECT <b>SOREN</b></span>
        <span class="live" id="liveStage">STAGE II</span>
        <span>DRIFT <b id="driftVal">+0.04</b></span>
      </div>
    </header>

    <section class="intro">
      <div class="intro-glow"></div>
      <span class="eyebrow">04 — The Power System</span>
      <h1>The Eyes of <em>Meszkhal</em></h1>
      <p class="sub">
        A Unique item bound to Soren at the mindscape bargain — distinct from the <em
          >Neurochromatic Eyes</em
        >, his interface. The Eyes of Meszkhal layer a second kind of sight over the first: six
        stages of perception that open wider channels onto the spectral substrate. Each one costs
        more than the last. Select a stage to read what the walker sees.
      </p>
      <div class="spectral-rule"></div>
    </section>

    <section class="console">
      <!-- stage rail -->
      <div class="rail" id="rail" role="tablist" aria-label="Ocular stages">
        <div class="rail-title">// Progression</div>
        <!-- buttons injected by JS -->
      </div>

      <!-- eye viewport -->
      <div class="viewport">
        <span class="vp-corner tl"></span><span class="vp-corner tr"></span><span
          class="vp-corner bl"></span><span class="vp-corner br"></span>
        <div class="vp-head">
          <span>NEUROCHROMATIC IMAGING</span><span id="vpHueName">CYAN BAND</span>
        </div>
        <div class="eye-stage">
          <div class="eye" id="eye">
            <svg viewBox="0 0 320 320" xmlns="http://www.w3.org/2000/svg" id="eye-svg">
              <defs>
                <!-- sclera -->
                <radialGradient id="grd-sclera" cx="50%" cy="46%" r="54%">
                  <stop offset="0%" stop-color="#10101a"></stop>
                  <stop offset="72%" stop-color="#0c0c16"></stop>
                  <stop offset="100%" stop-color="#060610"></stop>
                </radialGradient>
                <!-- iris — inner bright ring fading to deep dark; g0 updated by JS -->
                <radialGradient id="grd-iris" cx="50%" cy="50%" r="50%">
                  <stop id="ig0" offset="0%" stop-color="#4fd6e0" stop-opacity="0.0"></stop>
                  <stop id="ig1" offset="28%" stop-color="#4fd6e0" stop-opacity="0.55"></stop>
                  <stop id="ig2" offset="58%" stop-color="#0a0816" stop-opacity="1"></stop>
                  <stop id="ig3" offset="100%" stop-color="#060612" stop-opacity="1"></stop>
                </radialGradient>
                <!-- oil-slick sheen — conic, full iris; rotated slowly by JS -->
                <radialGradient id="grd-sheen" cx="38%" cy="34%" r="70%">
                  <stop offset="0%" stop-color="white" stop-opacity="0.18"></stop>
                  <stop offset="40%" stop-color="white" stop-opacity="0.04"></stop>
                  <stop offset="100%" stop-color="white" stop-opacity="0"></stop>
                </radialGradient>
                <!-- pupil depth -->
                <radialGradient id="grd-pupil" cx="44%" cy="40%" r="56%">
                  <stop id="pg0" offset="0%" stop-color="#1a0a2e"></stop>
                  <stop offset="60%" stop-color="#050508"></stop>
                  <stop offset="100%" stop-color="#000"></stop>
                </radialGradient>
                <!-- limbic glow behind limbal ring — wide soft halo -->
                <radialGradient id="grd-limbal-halo" cx="50%" cy="50%" r="50%">
                  <stop offset="70%" stop-color="transparent"></stop>
                  <stop id="lh0" offset="85%" stop-color="#4fd6e0" stop-opacity="0.0"></stop>
                  <stop id="lh1" offset="100%" stop-color="#4fd6e0" stop-opacity="0.0"></stop>
                </radialGradient>
                <!-- sweep wedge fill -->
                <radialGradient id="grd-sweep" cx="50%" cy="50%" r="50%">
                  <stop offset="0%" stop-color="white" stop-opacity="0.0"></stop>
                  <stop id="sw0" offset="55%" stop-color="#4fd6e0" stop-opacity="0.12"></stop>
                  <stop offset="100%" stop-color="#4fd6e0" stop-opacity="0.0"></stop>
                </radialGradient>
                <!-- filters -->
                <filter id="f-iris-glow" x="-20%" y="-20%" width="140%" height="140%">
                  <feGaussianBlur stdDeviation="5" result="b"></feGaussianBlur>
                  <feMerge
                    ><feMergeNode in="b"></feMergeNode><feMergeNode in="SourceGraphic"
                    ></feMergeNode></feMerge
                  >
                </filter>
                <filter id="f-limbal" x="-14%" y="-14%" width="128%" height="128%">
                  <feGaussianBlur stdDeviation="4.5" result="b"></feGaussianBlur>
                  <feMerge
                    ><feMergeNode in="b"></feMergeNode><feMergeNode in="SourceGraphic"
                    ></feMergeNode></feMerge
                  >
                </filter>
                <filter id="f-pupil-glow" x="-50%" y="-50%" width="200%" height="200%">
                  <feGaussianBlur stdDeviation="5" result="b"></feGaussianBlur>
                  <feMerge
                    ><feMergeNode in="b"></feMergeNode><feMergeNode in="SourceGraphic"
                    ></feMergeNode></feMerge
                  >
                </filter>
                <filter id="f-fiber-blur" x="-4%" y="-4%" width="108%" height="108%">
                  <feGaussianBlur stdDeviation="0.6"></feGaussianBlur>
                </filter>
                <filter id="f-vein" x="-10%" y="-10%" width="120%" height="120%">
                  <feGaussianBlur stdDeviation="1.2" result="b"></feGaussianBlur>
                  <feMerge
                    ><feMergeNode in="b"></feMergeNode><feMergeNode in="SourceGraphic"
                    ></feMergeNode></feMerge
                  >
                </filter>
                <!-- iris clip -->
                <clipPath id="cp-iris"><circle cx="160" cy="160" r="90"></circle></clipPath>
                <!-- outer eye clip (sclera boundary) -->
                <clipPath id="cp-eye"><circle cx="160" cy="160" r="155"></circle></clipPath>
              </defs>

              <!-- ── SCLERA ─────────────────────────────── -->
              <circle cx="160" cy="160" r="155" fill="url(#grd-sclera)"></circle>

              <!-- sclera vascular texture — faint branching paths, visible only at high stages -->
              <g id="veins" clip-path="url(#cp-eye)" opacity="0" style="transition:opacity 1s ease">
                <path
                  d="M90,100 Q110,130 95,160 Q82,185 100,210"
                  stroke="#c0393a"
                  stroke-width="0.8"
                  fill="none"
                  opacity="0.5"
                  filter="url(#f-vein)"></path>
                <path
                  d="M95,160 Q108,172 105,195"
                  stroke="#c0393a"
                  stroke-width="0.5"
                  fill="none"
                  opacity="0.35"
                  filter="url(#f-vein)"></path>
                <path
                  d="M230,95 Q210,125 225,158 Q236,182 218,210"
                  stroke="#c0393a"
                  stroke-width="0.7"
                  fill="none"
                  opacity="0.45"
                  filter="url(#f-vein)"></path>
                <path
                  d="M225,158 Q212,170 216,196"
                  stroke="#c0393a"
                  stroke-width="0.45"
                  fill="none"
                  opacity="0.3"
                  filter="url(#f-vein)"></path>
                <path
                  d="M140,75 Q145,95 138,115"
                  stroke="#c0393a"
                  stroke-width="0.5"
                  fill="none"
                  opacity="0.3"
                  filter="url(#f-vein)"></path>
                <path
                  d="M178,75 Q174,94 180,114"
                  stroke="#c0393a"
                  stroke-width="0.5"
                  fill="none"
                  opacity="0.28"
                  filter="url(#f-vein)"></path>
              </g>

              <!-- limbic halo — wide soft ring just outside iris, driven by emotional load -->
              <circle
                id="limbal-halo"
                cx="160"
                cy="160"
                r="155"
                fill="url(#grd-limbal-halo)"
                style="transition:opacity 0.8s ease"></circle>

              <!-- ── IRIS BASE ───────────────────────────── -->
              <circle
                id="iris-base"
                cx="160"
                cy="160"
                r="90"
                fill="url(#grd-iris)"
                filter="url(#f-iris-glow)"
                style="transition:filter 0.8s ease"></circle>

              <!-- ── IRIS STROMA FIBERS ─────────────────── -->
              <!-- Real iris has trabecular meshwork: irregular spokes + wavy crypts.
               We approximate with: primary radial spokes (heavier), secondary offset
               spokes (lighter), and arc-shaped crypt curves crossing them. -->
              <g id="iris-fibers" clip-path="url(#cp-iris)">
                <!-- Primary spokes — 24 at 15° intervals, length varies to avoid perfect geometry -->
                <g
                  id="spokes-primary"
                  filter="url(#f-fiber-blur)"
                  style="transition:opacity 0.7s ease"
                >
                  <line x1="160" y1="160" x2="160" y2="72" stroke="#4fd6e0" stroke-width="1.1"
                  ></line>
                  <line x1="160" y1="160" x2="201" y2="75" stroke="#4fd6e0" stroke-width="0.9"
                  ></line>
                  <line x1="160" y1="160" x2="237" y2="95" stroke="#4fd6e0" stroke-width="1.0"
                  ></line>
                  <line x1="160" y1="160" x2="260" y2="128" stroke="#4fd6e0" stroke-width="0.9"
                  ></line>
                  <line x1="160" y1="160" x2="268" y2="166" stroke="#4fd6e0" stroke-width="1.1"
                  ></line>
                  <line x1="160" y1="160" x2="257" y2="205" stroke="#4fd6e0" stroke-width="0.9"
                  ></line>
                  <line x1="160" y1="160" x2="234" y2="237" stroke="#4fd6e0" stroke-width="1.0"
                  ></line>
                  <line x1="160" y1="160" x2="199" y2="256" stroke="#4fd6e0" stroke-width="0.85"
                  ></line>
                  <line x1="160" y1="160" x2="160" y2="262" stroke="#4fd6e0" stroke-width="1.0"
                  ></line>
                  <line x1="160" y1="160" x2="120" y2="256" stroke="#4fd6e0" stroke-width="0.9"
                  ></line>
                  <line x1="160" y1="160" x2="85" y2="237" stroke="#4fd6e0" stroke-width="1.0"
                  ></line>
                  <line x1="160" y1="160" x2="63" y2="205" stroke="#4fd6e0" stroke-width="0.85"
                  ></line>
                  <line x1="160" y1="160" x2="52" y2="166" stroke="#4fd6e0" stroke-width="1.1"
                  ></line>
                  <line x1="160" y1="160" x2="62" y2="128" stroke="#4fd6e0" stroke-width="0.9"
                  ></line>
                  <line x1="160" y1="160" x2="84" y2="94" stroke="#4fd6e0" stroke-width="1.0"
                  ></line>
                  <line x1="160" y1="160" x2="120" y2="75" stroke="#4fd6e0" stroke-width="0.9"
                  ></line>
                </g>
                <!-- Secondary fine spokes — offset 7.5°, shorter, more varied -->
                <g id="spokes-secondary" opacity="0.45" style="transition:opacity 0.7s ease">
                  <line x1="160" y1="160" x2="180" y2="71" stroke="#4fd6e0" stroke-width="0.55"
                  ></line>
                  <line x1="160" y1="160" x2="220" y2="84" stroke="#4fd6e0" stroke-width="0.5"
                  ></line>
                  <line x1="160" y1="160" x2="252" y2="110" stroke="#4fd6e0" stroke-width="0.55"
                  ></line>
                  <line x1="160" y1="160" x2="267" y2="147" stroke="#4fd6e0" stroke-width="0.5"
                  ></line>
                  <line x1="160" y1="160" x2="264" y2="186" stroke="#4fd6e0" stroke-width="0.5"
                  ></line>
                  <line x1="160" y1="160" x2="246" y2="221" stroke="#4fd6e0" stroke-width="0.55"
                  ></line>
                  <line x1="160" y1="160" x2="218" y2="248" stroke="#4fd6e0" stroke-width="0.5"
                  ></line>
                  <line x1="160" y1="160" x2="180" y2="261" stroke="#4fd6e0" stroke-width="0.45"
                  ></line>
                  <line x1="160" y1="160" x2="140" y2="261" stroke="#4fd6e0" stroke-width="0.5"
                  ></line>
                  <line x1="160" y1="160" x2="101" y2="248" stroke="#4fd6e0" stroke-width="0.5"
                  ></line>
                  <line x1="160" y1="160" x2="73" y2="222" stroke="#4fd6e0" stroke-width="0.55"
                  ></line>
                  <line x1="160" y1="160" x2="55" y2="187" stroke="#4fd6e0" stroke-width="0.5"
                  ></line>
                  <line x1="160" y1="160" x2="52" y2="147" stroke="#4fd6e0" stroke-width="0.5"
                  ></line>
                  <line x1="160" y1="160" x2="67" y2="110" stroke="#4fd6e0" stroke-width="0.55"
                  ></line>
                  <line x1="160" y1="160" x2="100" y2="83" stroke="#4fd6e0" stroke-width="0.5"
                  ></line>
                  <line x1="160" y1="160" x2="140" y2="70" stroke="#4fd6e0" stroke-width="0.55"
                  ></line>
                </g>
                <!-- Iris crypts — arc curves crossing spokes, simulating trabecular gaps.
                 These are the "holes" in real iris texture. Drawn as short wavy arcs. -->
                <g
                  id="crypts"
                  opacity="0.0"
                  stroke="#4fd6e0"
                  fill="none"
                  style="transition:opacity 0.9s ease"
                >
                  <!-- outer crypt ring ~r70 -->
                  <path d="M218,108 Q230,140 218,172" stroke-width="0.7"></path>
                  <path d="M172,92  Q150,88  130,100" stroke-width="0.65"></path>
                  <path d="M103,108 Q92,138  102,170" stroke-width="0.7"></path>
                  <path d="M102,172 Q114,200 136,216" stroke-width="0.65"></path>
                  <path d="M186,216 Q206,200 218,172" stroke-width="0.65"></path>
                  <!-- inner crypt ring ~r45 -->
                  <path d="M196,130 Q204,160 195,190" stroke-width="0.55"></path>
                  <path d="M165,115 Q145,112 128,126" stroke-width="0.5"></path>
                  <path d="M126,130 Q118,158 127,188" stroke-width="0.55"></path>
                  <path d="M128,190 Q140,208 160,213" stroke-width="0.5"></path>
                  <path d="M160,213 Q180,208 195,190" stroke-width="0.5"></path>
                </g>
              </g>

              <!-- ── COLLARETTE (mid-iris border zone) ──── -->
              <!-- The collarette is the serrated boundary between pupil zone and ciliary zone.
               Approximated with a dashed arc + small notch marks. -->
              <circle
                id="collarette-ring"
                cx="160"
                cy="160"
                r="52"
                fill="none"
                stroke="#4fd6e0"
                stroke-width="1.0"
                stroke-dasharray="2.8 3.6"
                opacity="0.0"
                clip-path="url(#cp-iris)"
                style="transition:opacity 0.8s ease, stroke 0.7s ease"></circle>
              <!-- collarette notches — tiny radial ticks -->
              <g
                id="collarette-notches"
                opacity="0.0"
                clip-path="url(#cp-iris)"
                style="transition:opacity 0.8s ease"
              >
                <line x1="160" y1="108" x2="160" y2="114" stroke="#4fd6e0" stroke-width="0.8"
                ></line>
                <line x1="196" y1="116" x2="193" y2="122" stroke="#4fd6e0" stroke-width="0.7"
                ></line>
                <line x1="214" y1="148" x2="208" y2="150" stroke="#4fd6e0" stroke-width="0.7"
                ></line>
                <line x1="205" y1="187" x2="200" y2="183" stroke="#4fd6e0" stroke-width="0.7"
                ></line>
                <line x1="176" y1="209" x2="173" y2="203" stroke="#4fd6e0" stroke-width="0.7"
                ></line>
                <line x1="144" y1="209" x2="147" y2="203" stroke="#4fd6e0" stroke-width="0.7"
                ></line>
                <line x1="115" y1="187" x2="120" y2="183" stroke="#4fd6e0" stroke-width="0.7"
                ></line>
                <line x1="106" y1="148" x2="112" y2="150" stroke="#4fd6e0" stroke-width="0.7"
                ></line>
                <line x1="124" y1="116" x2="127" y2="122" stroke="#4fd6e0" stroke-width="0.7"
                ></line>
              </g>

              <!-- ── OIL-SLICK SHEEN (spectral refraction) ─ -->
              <circle
                cx="160"
                cy="160"
                r="90"
                fill="url(#grd-sheen)"
                clip-path="url(#cp-iris)"
                opacity="0.7"></circle>

              <!-- ── SCAN SWEEP (active perception rotating line) ─ -->
              <g clip-path="url(#cp-iris)">
                <g
                  id="sweep-group"
                  style="transform-origin:160px 160px; animation:sweep-rot 5s linear infinite"
                >
                  <!-- sweep wedge: thin conic slice -->
                  <path
                    id="sweep-wedge"
                    d="M160,160 L160,70 A90,90 0 0,1 195,73 Z"
                    fill="url(#grd-sweep)"
                    opacity="0.7"></path>
                  <!-- leading edge line -->
                  <line
                    id="sweep-line"
                    x1="160"
                    y1="160"
                    x2="160"
                    y2="70"
                    stroke="#4fd6e0"
                    stroke-width="0.8"
                    opacity="0.6"></line>
                </g>
              </g>

              <!-- ── LIMBAL RING ──────────────────────────── -->
              <!-- The biological limbal ring — where the iris meets the sclera.
               This is the emotional warning light. Animated pulse intensity tracks stage. -->
              <circle
                id="limbal-ring"
                cx="160"
                cy="160"
                r="90"
                fill="none"
                stroke="#4fd6e0"
                stroke-width="2.8"
                opacity="0.55"
                filter="url(#f-limbal)"
                style="animation:limbal-pulse 2.4s ease-in-out infinite; --lp-lo:0.45; --lp-hi:0.85; transition:stroke 0.7s ease, stroke-width 0.7s ease"
              ></circle>

              <!-- ── PUPIL ───────────────────────────────── -->
              <!-- Slightly irregular — not a perfect circle. Use polygon approx.
               The pupil shape changes with stage via r attribute. -->
              <circle
                id="pupil-glow"
                cx="160"
                cy="160"
                r="33"
                fill="url(#grd-pupil)"
                filter="url(#f-pupil-glow)"
                style="transition:r 0.8s ease"></circle>
              <!-- the true void -->
              <circle
                id="pupil-void"
                cx="160"
                cy="160"
                r="26"
                fill="#000"
                style="transition:r 0.8s ease"></circle>
              <!-- pupil edge — faint ring to give boundary definition -->
              <circle
                id="pupil-edge"
                cx="160"
                cy="160"
                r="26"
                fill="none"
                stroke="#4fd6e0"
                stroke-width="0.7"
                opacity="0.0"
                style="transition:r 0.8s ease, opacity 0.8s ease, stroke 0.7s ease"></circle>

              <!-- ── GLINTS ──────────────────────────────── -->
              <ellipse
                id="glint-main"
                cx="146"
                cy="147"
                rx="7"
                ry="4.5"
                fill="white"
                opacity="0.22"
                transform="rotate(-18,146,147)"></ellipse>
              <ellipse
                id="glint-small"
                cx="170"
                cy="151"
                rx="2.8"
                ry="1.8"
                fill="white"
                opacity="0.12"
                transform="rotate(8,170,151)"></ellipse>
            </svg>
            <div class="eye-floats" id="floats">
              <span class="f1">λ 488nm</span><span class="f2">θ 0.04</span><span class="f3"
                >∮ stable</span
              ><span class="f4">Δ +1</span>
            </div>
          </div>
        </div>
        <div class="vp-foot">
          <span>OCULAR STAGE <b id="vpStage">II — IRIS REFRACTION</b></span>
          <div class="nav-arrows">
            <button id="prevBtn" aria-label="Previous stage">‹</button>
            <button id="nextBtn" aria-label="Next stage">›</button>
          </div>
        </div>
      </div>

      <!-- data panel -->
      <div class="data">
        <div class="fade-key" id="dataKey">
          <span class="d-num" id="dNum">STAGE II / VI</span>
          <h2 class="d-name" id="dName">Iris <em>Refraction</em></h2>
          <p class="d-desc" id="dDesc">Sight resolves into bands.</p>

          <div class="d-block">
            <div class="d-label">What the walker sees</div>
            <p class="d-see" id="dSee">—</p>
          </div>

          <div class="d-block">
            <div class="d-label">Effect</div>
            <p class="d-effect" id="dEffect">—</p>
          </div>

          <div class="d-block">
            <div class="d-label">Diagnostics</div>
            <div class="meters">
              <div class="meter perception">
                <div class="m-head">
                  <span>Perception</span><span class="m-val" id="mvPerception">0%</span>
                </div><div class="track"><i id="mPerception"></i></div>
              </div>
              <div class="meter strain">
                <div class="m-head">
                  <span>Neural strain</span><span class="m-val" id="mvStrain">0%</span>
                </div><div class="track"><i id="mStrain"></i></div>
              </div>
              <div class="meter control">
                <div class="m-head">
                  <span>Control</span><span class="m-val" id="mvControl">0%</span>
                </div><div class="track"><i id="mControl"></i></div>
              </div>
            </div>
          </div>

          <div class="cost">
            <div class="c-label">The cost</div>
            <p class="c-text" id="dCost">—</p>
          </div>
        </div>
      </div>
    </section>

    <!-- stepper -->
    <div class="stepbar">
      <div class="track">
        <div class="fill" id="stepFill"></div><div class="nodes" id="stepNodes"></div>
      </div>
      <div class="caption"><span>I · Awakening</span><span>VI · Coherence</span></div>
    </div>

    <!-- closer -->
    <section class="closer">
      <div class="closer-in">
        <h2>The interface is a mercy, not a truth. <em>Soren is only at Stage II.</em></h2>
        <div class="actions">
          <a href={base} class="btn btn-primary">Buy the book <span>→</span></a>
          <a href={`${base}codex`} class="btn btn-ghost">Explore the World <span>→</span></a>
        </div>
      </div>
    </section>

    <script is:inline>
      // ---- Stage data. Hues are the constant spectral DNA (cyan→amber). ----
      const STAGES = [
        {
          num: 'I',
          name: 'Limbal <em>Shift</em>',
          plain: 'Limbal Shift',
          hue: '#4fd6e0',
          band: 'CYAN BAND',
          wl: 'λ 488nm',
          desc: 'The first awakening.',
          see: 'A faint iridescence at the rim of everything — doorways, hands, the horizon — as if the world were laminated under glass and the edge of the glass had just caught the light. The walker cannot yet read it. They only know, for the first time, that the Realm has more than one layer.',
          effect:
            '<span class="tag">UNLOCKS</span> passive layer-sense. The walker registers that interfaces exist, but cannot resolve them. No active control.',
          perception: 18,
          strain: 10,
          control: 28,
          cost: 'A permanent ache behind the eye, like a held breath that never releases. Minor — and never noticed again until it is gone.',
        },
        {
          num: 'II',
          name: 'Iris <em>Refraction</em>',
          plain: 'Iris Refraction',
          hue: '#6b8def',
          band: 'AZURE BAND',
          wl: 'λ 470nm',
          desc: 'Sight resolves into bands.',
          see: 'The iridescence separates into legible color. Threats glow one hue, ley-lines another, intention a third; the world sorts itself into a readable spectrum. This is where the implant stabilizes the Realm into something a human mind can hold — the stage Soren walks in now.',
          effect:
            '<span class="tag">STABILIZES</span> the RPG interface. Health, threat, and affinity render as discrete bands. First reliable reading of the substrate.',
          perception: 38,
          strain: 24,
          control: 48,
          cost: 'Recurring spectral migraines — colors that arrive before the things they belong to. Manageable, with rest the walker rarely gets.',
        },
        {
          num: 'III',
          name: 'Neuro-Optical <em>Overdrive</em>',
          plain: 'Neuro-Optical Overdrive',
          hue: '#8a7bf0',
          band: 'INDIGO BAND',
          wl: 'λ 445nm',
          desc: 'Perception outpaces the body.',
          see: 'Too much, too fast. Every surface volunteers its data at once; the walker reads a room faster than they can cross it, predicts a blow before the muscle to dodge it can fire. Knowledge arrives with no time to use it — a flood with no shore.',
          effect:
            '<span class="tag">GRANTS</span> precognitive read; <span class="tag">RISK</span> sensory flooding and lost time. The gap between seeing and acting becomes a wound.',
          perception: 66,
          strain: 60,
          control: 38,
          cost: 'Dangerous. Walkers at Overdrive lose minutes, then hours, standing perfectly still inside a single perfect second.',
        },
        {
          num: 'IV',
          name: 'Spectral <em>Partition</em>',
          plain: 'Spectral Partition',
          hue: '#9b6cf0',
          band: 'VIOLET BAND',
          wl: 'λ 420nm',
          desc: 'The first true act of command.',
          see: 'The flood is dammed. The walker learns to lift one thread of reality and hold it apart from the rest — isolating a single channel of the substrate, silencing the others, reading one truth at a time. The Realm stops happening to them. They begin to choose where to look.',
          effect:
            '<span class="tag">UNLOCKS</span> channel isolation — suppress or amplify one band at will. The first stage that acts <em>on</em> the Realm, not just within it.',
          perception: 78,
          strain: 52,
          control: 68,
          cost: 'Identity bleed. Each isolated channel begins to feel like a separate self — and not all of them want the same things.',
        },
        {
          num: 'V',
          name: 'Gaze <em>Interference</em>',
          plain: 'Gaze Interference',
          hue: '#ef6f9e',
          band: 'ROSE BAND',
          wl: 'λ 405nm',
          desc: 'To look is to alter.',
          see: 'Attention becomes a force. Wherever the walker fixes their gaze, the substrate bends toward it — dampened, amplified, rerouted. Reality flinches under the eye. They no longer merely observe a thread; they pull it. The watched world is changed by the watching.',
          effect:
            '<span class="tag">GRANTS</span> active substrate manipulation by focus. <span class="tag">RISK</span> every alteration leaves a trace — on the Realm, and on the one who made it.',
          perception: 90,
          strain: 76,
          control: 74,
          cost: 'Every gaze marks the gazer. Walkers at Interference are read by what they have looked at, the way a blade remembers its edge.',
        },
        {
          num: 'VI',
          name: 'Prism <em>Coherence</em>',
          plain: 'Prism Coherence',
          hue: '#e0a850',
          band: 'FULL SPECTRUM',
          wl: 'λ ∞',
          desc: 'All bands resolve into one.',
          see: 'The interface dissolves. There are no more bands, no numbers, no merciful translation — only the Realm, perceived whole and unmediated, exactly as it is. The walker sees the substrate not as a game rendered for a mind, but as the thing the game was always standing in front of. Few minds survive the clarity intact.',
          effect:
            '<span class="tag">RESOLVES</span> all channels into unity. Interface offline. Direct contact with the substrate. <span class="tag">TERMINAL</span> — there is no Stage VII, only what one becomes here.',
          perception: 100,
          strain: 94,
          control: 96,
          cost: 'Most who reach coherence do not return as themselves. The clarity is total, and it does not give back what it takes to see.',
        },
      ];

      const rail = document.getElementById('rail');
      const eye = document.getElementById('eye');
      // rings driven by SVG now
      const root = document.documentElement;
      let current = 1; // start at Iris Refraction (Soren's stage)
      // build rail buttons
      STAGES.forEach((s, i) => {
        const btn = document.createElement('button');
        btn.className = 'stage-btn';
        btn.setAttribute('role', 'tab');
        btn.setAttribute('aria-selected', 'false');
        btn.style.setProperty('--hue', s.hue);
        btn.dataset.index = i;
        btn.innerHTML = `<span class="connector"></span><span class="dot"></span><span><span class="s-num">STAGE ${s.num}</span><span class="s-name">${s.plain}</span></span>`;
        btn.addEventListener('click', () => select(i));
        rail.appendChild(btn);
      });
      const railBtns = [...rail.querySelectorAll('.stage-btn')];

      // build stepper nodes
      const stepNodes = document.getElementById('stepNodes');
      STAGES.forEach(() => {
        const n = document.createElement('span');
        n.className = 'pnode';
        stepNodes.appendChild(n);
      });
      const pnodes = [...stepNodes.querySelectorAll('.pnode')];

      const els = {
        dataKey: document.getElementById('dataKey'),
        dNum: document.getElementById('dNum'),
        dName: document.getElementById('dName'),
        dDesc: document.getElementById('dDesc'),
        dSee: document.getElementById('dSee'),
        dEffect: document.getElementById('dEffect'),
        dCost: document.getElementById('dCost'),
        vpStage: document.getElementById('vpStage'),
        vpHueName: document.getElementById('vpHueName'),
        liveStage: document.getElementById('liveStage'),
        driftVal: document.getElementById('driftVal'),
        stepFill: document.getElementById('stepFill'),
        mPerception: document.getElementById('mPerception'),
        mStrain: document.getElementById('mStrain'),
        mControl: document.getElementById('mControl'),
        mvPerception: document.getElementById('mvPerception'),
        mvStrain: document.getElementById('mvStrain'),
        mvControl: document.getElementById('mvControl'),
        prevBtn: document.getElementById('prevBtn'),
        nextBtn: document.getElementById('nextBtn'),
        floats: [...document.querySelectorAll('#floats span')],
      };

      // ── per-stage config ──────────────────────────────────────────────────────
      // pupilR: how much the pupil dilates/contracts per stage
      // fiberOp: opacity of iris fiber spokes (lower = more dissolved at high stages)
      // cryptOp: collarette + crypt visibility (appear as fibers activate, stage 2+)
      // veinOp: scleral vein visibility (stress marker, spikes at 3,5)
      // limbalW: limbal ring stroke-width (grows with limbic load)
      // limbalPulse: [lo, hi] opacity for animation
      // sweepDur: rotation speed
      // glintOp: glint fades as clarity dissolves at high stages
      const STAGE_CFG = [
        // I — Limbal Shift: looks almost like a normal eye. Limbal ring just waking.
        {
          pupilR: 28,
          pupilCoreR: 22,
          fiberOp: 0.28,
          cryptOp: 0.0,
          veinOp: 0.0,
          limbalW: 2.2,
          lp: [0.35, 0.7],
          sweepDur: 6.0,
          glintOp: 0.22,
          sweepOp: 0.06,
        },
        // II — Iris Refraction: fibers begin activating, faint color bands
        {
          pupilR: 30,
          pupilCoreR: 23,
          fiberOp: 0.5,
          cryptOp: 0.18,
          veinOp: 0.0,
          limbalW: 2.8,
          lp: [0.5, 0.9],
          sweepDur: 5.0,
          glintOp: 0.2,
          sweepOp: 0.1,
        },
        // III — Overdrive: flood of data, pupil dilates wide, veins strain
        {
          pupilR: 38,
          pupilCoreR: 30,
          fiberOp: 0.72,
          cryptOp: 0.45,
          veinOp: 0.55,
          limbalW: 3.4,
          lp: [0.65, 1.0],
          sweepDur: 3.4,
          glintOp: 0.14,
          sweepOp: 0.16,
        },
        // IV — Spectral Partition: controlled, iris almost architectural
        {
          pupilR: 26,
          pupilCoreR: 20,
          fiberOp: 0.85,
          cryptOp: 0.7,
          veinOp: 0.25,
          limbalW: 3.8,
          lp: [0.6, 0.95],
          sweepDur: 4.0,
          glintOp: 0.13,
          sweepOp: 0.2,
        },
        // V — Gaze Interference: the eye as weapon, veins peak, pupil irregular
        {
          pupilR: 34,
          pupilCoreR: 27,
          fiberOp: 0.92,
          cryptOp: 0.88,
          veinOp: 0.8,
          limbalW: 4.4,
          lp: [0.75, 1.0],
          sweepDur: 2.8,
          glintOp: 0.07,
          sweepOp: 0.28,
        },
        // VI — Prism Coherence: pure. No strain. Veins gone. Limbal ring blazing steady.
        {
          pupilR: 22,
          pupilCoreR: 17,
          fiberOp: 1.0,
          cryptOp: 1.0,
          veinOp: 0.0,
          limbalW: 5.0,
          lp: [0.9, 1.0],
          sweepDur: 1.8,
          glintOp: 0.04,
          sweepOp: 0.36,
        },
      ];

      function renderEye(idx) {
        const s = STAGES[idx];
        const cf = STAGE_CFG[idx];
        root.style.setProperty('--stage-hue', s.hue);
        const hue = s.hue;

        // ── iris gradients ───────────────────────────────────────────────────────
        document.getElementById('ig1').setAttribute('stop-color', hue);
        document.getElementById('ig1').setAttribute('stop-opacity', (0.35 + idx * 0.07).toFixed(2));
        document
          .getElementById('pg0')
          .setAttribute(
            'stop-color',
            idx >= 4 ? `color-mix(in srgb, ${hue} 20%, #1a0a2e)` : '#1a0a2e',
          );

        // ── limbal halo (wide glow behind limbal ring) ───────────────────────────
        const haloOp = 0.0 + idx * 0.08;
        document.getElementById('lh0').setAttribute('stop-color', hue);
        document.getElementById('lh0').setAttribute('stop-opacity', (haloOp * 0.5).toFixed(3));
        document.getElementById('lh1').setAttribute('stop-color', hue);
        document.getElementById('lh1').setAttribute('stop-opacity', haloOp.toFixed(3));

        // ── iris fibers ──────────────────────────────────────────────────────────
        const sp = document.getElementById('spokes-primary');
        const ss = document.getElementById('spokes-secondary');
        sp.querySelectorAll('line').forEach((l) => l.setAttribute('stroke', hue));
        ss.querySelectorAll('line').forEach((l) => l.setAttribute('stroke', hue));
        sp.setAttribute('opacity', cf.fiberOp.toFixed(2));
        ss.setAttribute('opacity', (cf.fiberOp * 0.45).toFixed(2));

        // ── crypts + collarette ──────────────────────────────────────────────────
        const crypts = document.getElementById('crypts');
        const collar = document.getElementById('collarette-ring');
        const cnotches = document.getElementById('collarette-notches');
        crypts.setAttribute('opacity', cf.cryptOp.toFixed(2));
        crypts.querySelectorAll('path').forEach((p) => p.setAttribute('stroke', hue));
        collar.setAttribute('opacity', cf.cryptOp.toFixed(2));
        collar.setAttribute('stroke', hue);
        cnotches.setAttribute('opacity', cf.cryptOp.toFixed(2));
        cnotches.querySelectorAll('line').forEach((l) => l.setAttribute('stroke', hue));

        // ── scleral veins ────────────────────────────────────────────────────────
        document.getElementById('veins').style.opacity = cf.veinOp.toFixed(2);

        // ── limbal ring ──────────────────────────────────────────────────────────
        const limb = document.getElementById('limbal-ring');
        limb.setAttribute('stroke', hue);
        limb.setAttribute('stroke-width', cf.limbalW.toFixed(1));
        limb.style.setProperty('--lp-lo', cf.lp[0].toFixed(2));
        limb.style.setProperty('--lp-hi', cf.lp[1].toFixed(2));
        // pulse speed also tightens with stage (more autonomic arousal)
        const pulseDur = (2.8 - idx * 0.28).toFixed(2);
        limb.style.animationDuration = pulseDur + 's';

        // ── pupil ────────────────────────────────────────────────────────────────
        document.getElementById('pupil-glow').setAttribute('r', cf.pupilR);
        document.getElementById('pupil-void').setAttribute('r', cf.pupilCoreR);
        const pedge = document.getElementById('pupil-edge');
        pedge.setAttribute('r', cf.pupilCoreR);
        pedge.setAttribute('stroke', hue);
        pedge.setAttribute('opacity', idx >= 3 ? '0.45' : '0.0');

        // ── sweep ────────────────────────────────────────────────────────────────
        const sweepG = document.getElementById('sweep-group');
        sweepG.style.animationDuration = cf.sweepDur.toFixed(1) + 's';
        document.getElementById('sweep-wedge').setAttribute('opacity', cf.sweepOp.toFixed(2));
        document.getElementById('sweep-line').setAttribute('stroke', hue);
        document.getElementById('sw0').setAttribute('stop-color', hue);

        // ── glints ───────────────────────────────────────────────────────────────
        document.getElementById('glint-main').setAttribute('opacity', cf.glintOp.toFixed(2));
        document
          .getElementById('glint-small')
          .setAttribute('opacity', (cf.glintOp * 0.55).toFixed(2));

        // ── floats ───────────────────────────────────────────────────────────────
        els.floats.forEach((f, fi) => {
          f.classList.toggle('on', fi <= idx);
        });
        els.floats[0].textContent = s.wl;
      }

      function animateMeter(barEl, valEl, target) {
        barEl.style.width = target + '%';
        // immediate fallback so the number is always correct even if the clock
        // is frozen (unfocused preview) and requestAnimationFrame never ticks
        valEl.textContent = target + '%';
        if (!MOTION) return;
        const start = parseInt(valEl.textContent) || 0;
        const t0 = performance.now();
        function tick(t) {
          const k = Math.min(1, (t - t0) / 600);
          const v = Math.round(start + (target - start) * (k * (2 - k))); // easeOut
          valEl.textContent = v + '%';
          if (k < 1) requestAnimationFrame(tick);
        }
        requestAnimationFrame(tick);
      }

      function select(idx, instant) {
        if (idx < 0 || idx > STAGES.length - 1) return;
        current = idx;
        const s = STAGES[idx];

        // rail state
        railBtns.forEach((b, i) => {
          b.setAttribute('aria-selected', i === idx ? 'true' : 'false');
          b.dataset.reached = i <= idx ? 'true' : 'false';
          // reached connectors/dots glow up to current
          b.querySelector('.dot').style.boxShadow = i <= idx ? '0 0 12px ' + STAGES[i].hue : 'none';
          b.querySelector('.dot').style.background = i <= idx ? STAGES[i].hue : 'transparent';
        });

        // stepper
        els.stepFill.style.width = (idx / (STAGES.length - 1)) * 100 + '%';
        pnodes.forEach((n, i) => n.classList.toggle('on', i <= idx));

        // eye
        renderEye(idx);

        // readouts
        els.vpStage.innerHTML = s.num + ' — ' + s.plain.toUpperCase();
        els.vpHueName.textContent = s.band;
        els.liveStage.textContent = 'STAGE ' + s.num;
        els.driftVal.textContent = '+' + (0.04 + idx * 0.18).toFixed(2);

        // arrows
        els.prevBtn.disabled = idx === 0;
        els.nextBtn.disabled = idx === STAGES.length - 1;

        // swap text. With motion confirmed, fade out→in; otherwise set instantly
        // (and never leave the panel stranded at opacity:0).
        function applyText() {
          els.dNum.textContent = 'STAGE ' + s.num + ' / VI';
          els.dName.innerHTML = s.name;
          els.dDesc.textContent = s.desc;
          els.dSee.textContent = s.see;
          els.dEffect.innerHTML = s.effect;
          els.dCost.textContent = s.cost;
        }
        if (instant || !MOTION) {
          els.dataKey.classList.remove('swapping');
          applyText();
        } else {
          els.dataKey.classList.add('swapping');
          setTimeout(() => {
            applyText();
            els.dataKey.classList.remove('swapping');
          }, 200);
        }

        // meters
        animateMeter(els.mPerception, els.mvPerception, s.perception);
        animateMeter(els.mStrain, els.mvStrain, s.strain);
        animateMeter(els.mControl, els.mvControl, s.control);
      }

      els.prevBtn.addEventListener('click', () => select(current - 1));
      els.nextBtn.addEventListener('click', () => select(current + 1));
      document.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
          e.preventDefault();
          select(Math.min(STAGES.length - 1, current + 1));
        } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
          e.preventDefault();
          select(Math.max(0, current - 1));
        }
      });

      // initial render is instant (no fade) so first paint is always visible
      let MOTION = false;
      select(current, true);

      // Confirm the animation clock actually advances before enabling motion-
      // dependent transitions (fades, meter fills). Frozen/unfocused previews
      // keep everything in its visible end-state instead of stranding at 0.
      (function probeMotion() {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        const probe = document.createElement('div');
        probe.style.cssText =
          'position:fixed;opacity:0;pointer-events:none;transition:opacity .15s linear';
        document.body.appendChild(probe);
        requestAnimationFrame(() => {
          probe.style.opacity = '1';
        });
        setTimeout(() => {
          const advancing = parseFloat(getComputedStyle(probe).opacity) > 0.05;
          probe.remove();
          if (advancing) {
            MOTION = true;
            document.body.classList.add('motion');
          }
        }, 260);
      })();
    </script>
    <Analytics />
  </body>
</html>
