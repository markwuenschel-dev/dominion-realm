---
import { Image } from 'astro:assets';
import CodexLayout from '../../layouts/CodexLayout.astro';
import {
  getJournalPosts,
  journalUrl,
  journalKicker,
  CATEGORY_LABELS,
  JOURNAL_CATEGORIES,
} from '../../lib/journal';
import '../../styles/journal.css';

const posts = await getJournalPosts();
const base = import.meta.env.BASE_URL;

// Filter options: All + each stream. The filter is purely additive over a DOM
// that already renders every post (see below) — no-JS readers see everything.
const filters = [
  { value: 'all', label: 'All' },
  ...JOURNAL_CATEGORIES.map((c) => ({ value: c, label: CATEGORY_LABELS[c] })),
];
---

<CodexLayout
  title="The Author Journal"
  description="Dispatches from inside the Realm and notes from the author's desk — two streams from the world of The Dominion Realm."
>
  <div class="journal-head">
    <span class="journal-head__label">The Author Journal</span>
    <h1 class="journal-head__title">Dispatches & the <em>Desk</em></h1>
    <p class="journal-head__intro">
      Two streams from the making of The Dominion Realm.
      <strong>Field Notes</strong> are written from inside the Realm — fragments of what the interface
      shows, and what it leaves out. <strong>From the Desk</strong>
      collects the author's notes on craft and process. Filter below, or read it all.
    </p>
  </div>

  <div class="journal-controls">
    <div class="journal-filter" role="group" aria-label="Filter by stream">
      {
        filters.map((f) => (
          <a
            class="journal-filter__btn"
            href={f.value === 'all' ? `${base}journal` : `${base}journal#${f.value}`}
            data-filter={f.value}
            aria-pressed={f.value === 'all' ? 'true' : 'false'}
          >
            {f.label}
          </a>
        ))
      }
    </div>
    <a class="journal-feed" href={`${base}rss.xml`}>RSS Feed →</a>
  </div>

  {
    posts.length === 0 ? (
      <p class="journal-empty">No entries yet. Check back soon.</p>
    ) : (
      <div class="journal-list" id="journal-list">
        {posts.map((post) => (
          <a
            class="journal-item"
            href={journalUrl(base, post.id)}
            data-category={post.data.category}
          >
            {post.data.image && (
              <figure class="journal-item__media">
                <Image
                  src={post.data.image}
                  width={600}
                  alt={post.data.imageAlt ?? post.data.title}
                />
              </figure>
            )}
            <span class="journal-item__kicker">{journalKicker(post)}</span>
            <h2 class="journal-item__title">{post.data.title}</h2>
            <p class="journal-item__summary">{post.data.summary}</p>
          </a>
        ))}
      </div>
    )
  }
</CodexLayout>

<script is:inline>
  (function () {
    const VALID = ['all', 'field-notes', 'from-the-desk'];
    const buttons = Array.from(document.querySelectorAll('[data-filter]'));
    const items = Array.from(document.querySelectorAll('.journal-item'));
    if (!buttons.length || !items.length) return;

    function normalize(hash) {
      const value = (hash || '').replace(/^#/, '');
      return VALID.includes(value) ? value : 'all';
    }

    function apply(filter) {
      items.forEach((item) => {
        const match = filter === 'all' || item.getAttribute('data-category') === filter;
        item.classList.toggle('is-hidden', !match);
      });
      buttons.forEach((btn) => {
        btn.setAttribute(
          'aria-pressed',
          btn.getAttribute('data-filter') === filter ? 'true' : 'false',
        );
      });
    }

    buttons.forEach((btn) => {
      btn.addEventListener('click', (event) => {
        event.preventDefault();
        const filter = btn.getAttribute('data-filter') || 'all';
        // Reflect state in the URL hash without scrolling (replaceState keeps history clean).
        const url = filter === 'all' ? location.pathname + location.search : '#' + filter;
        history.replaceState(null, '', url);
        apply(filter);
      });
    });

    window.addEventListener('hashchange', () => apply(normalize(location.hash)));
    apply(normalize(location.hash));
  })();
</script>
