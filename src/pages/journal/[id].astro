---
import { render } from 'astro:content';
import CodexLayout from '../../layouts/CodexLayout.astro';
import RevealGate from '../../components/RevealGate.astro';
import { getJournalPosts, journalKicker, formatJournalDate } from '../../lib/journal';

export async function getStaticPaths() {
  const posts = await getJournalPosts();
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const base = import.meta.env.BASE_URL;
const { Content } = await render(post);
const kicker = journalKicker(post);
const tier = post.data.reveal;
---

<CodexLayout title={post.data.title} description={post.data.summary}>
  <article class="journal-post">
    <span class="journal-post__kicker">{kicker}</span>
    <h1 class="journal-post__title">{post.data.title}</h1>
    <p class="journal-post__summary">{post.data.summary}</p>
    {
      post.data.updatedDate && (
        <span class="journal-post__updated">
          Updated {formatJournalDate(post.data.updatedDate)}
        </span>
      )
    }
    <div class="codex-rule"></div>

    {
      post.data.image && (
        <figure class="journal-post__media">
          <img
            src={post.data.image.src}
            width={post.data.image.width}
            height={post.data.image.height}
            alt={post.data.imageAlt ?? post.data.title}
          />
        </figure>
      )
    }

    <div class="journal-prose">
      <RevealGate tier={tier}>
        <Content />
      </RevealGate>
    </div>

    <a class="journal-back" href={`${base}journal`}>← All entries</a>
  </article>
</CodexLayout>
