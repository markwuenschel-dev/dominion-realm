---
import { render } from 'astro:content';
import ReadingLayout from '../../layouts/ReadingLayout.astro';
import { getReadingEntries, readingUrl, readingKicker, getNeighbors } from '../../lib/reading';

export async function getStaticPaths() {
  const entries = await getReadingEntries();
  return entries.map((entry) => ({
    params: { id: entry.id },
    props: { entry, entries },
  }));
}

const { entry, entries } = Astro.props;
const base = import.meta.env.BASE_URL;
const { Content } = await render(entry);
const kicker = readingKicker(entry);
const { prev, next } = getNeighbors(entries, entry.id);
---

<ReadingLayout title={entry.data.title} description={entry.data.summary}>
  <article class="reading-article">
    <span class="reading-article__kicker">{kicker}</span>
    <h1 class="reading-article__title">{entry.data.title}</h1>
    <p class="reading-article__summary">{entry.data.summary}</p>
    <div class="reading-article__rule"></div>

    <div class="reading-prose">
      <Content />
    </div>
  </article>

  {
    (prev || next) && (
      <nav class="reading-nav" aria-label="Chapter navigation">
        {prev && (
          <a class="reading-nav__link reading-nav__link--prev" href={readingUrl(base, prev.id)}>
            <span class="reading-nav__dir">← Previous</span>
            <span class="reading-nav__title">{prev.data.title}</span>
          </a>
        )}
        {next && (
          <a class="reading-nav__link reading-nav__link--next" href={readingUrl(base, next.id)}>
            <span class="reading-nav__dir">Next →</span>
            <span class="reading-nav__title">{next.data.title}</span>
          </a>
        )}
      </nav>
    )
  }

  <a class="reading-back" href={`${base}read`}>← All chapters</a>
</ReadingLayout>
