---
import ReadingLayout from '../../layouts/ReadingLayout.astro';
import { getReadingEntries, readingUrl, readingKicker } from '../../lib/reading';

const entries = await getReadingEntries();
const base = import.meta.env.BASE_URL;
// The primary CTA points at the first piece in reading order (the Prologue).
const first = entries[0];
---

<ReadingLayout
  title="Read the Opening"
  description="Read the Prologue and Chapter One of The Dominion Realm in full — no sign-up, no spoilers, just the opening of the book."
  showIndexLink={false}
>
  <div class="reading-head">
    <span class="reading-head__label">The Reading Sample</span>
    <h1 class="reading-head__title">Begin the <em>Realm</em></h1>
    <p class="reading-head__intro">
      The opening of the book, in full and unguarded — the Prologue and Chapter One. No sign-up, no
      spoiler gate, no catch. Soren wakes somewhere that isn't Earth, in a world his implant insists
      on translating into a game. Read until the translation starts to fail.
    </p>
    <div class="reading-rule"></div>
  </div>

  {
    first && (
      <a class="reading-cta" href={readingUrl(base, first.id)}>
        <span>Start reading</span>
        <span class="reading-cta__hint">{readingKicker(first)}</span>
      </a>
    )
  }

  <div class="reading-list">
    {
      entries.map((entry) => (
        <a class="reading-item" href={readingUrl(base, entry.id)}>
          <span class="reading-item__kicker">{readingKicker(entry)}</span>
          <h2 class="reading-item__title">{entry.data.title}</h2>
          <p class="reading-item__summary">{entry.data.summary}</p>
        </a>
      ))
    }
  </div>
</ReadingLayout>
