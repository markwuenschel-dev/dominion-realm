---
import { render } from 'astro:content';
import CodexLayout from '../../../layouts/CodexLayout.astro';
import RevealGate from '../../../components/RevealGate.astro';
import {
  getAllCodexEntries,
  entryKicker,
  resolveRelationships,
  COLLECTION_LABELS,
} from '../../../lib/codex';

export async function getStaticPaths() {
  const entries = await getAllCodexEntries();
  return entries.map((entry) => ({
    params: { collection: entry.collection, id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const base = import.meta.env.BASE_URL;
const all = await getAllCodexEntries();
const { Content } = await render(entry);
const kicker = entryKicker(entry);
const tier = entry.data.reveal;
const links = resolveRelationships(base, entry, all);
---

<CodexLayout title={entry.data.name} description={entry.data.summary}>
  <article class="codex-entry">
    <span class="codex-entry__kicker">{COLLECTION_LABELS[entry.collection]} · {kicker}</span>
    <h1 class="codex-entry__title">{entry.data.name}</h1>
    <p class="codex-entry__summary">{entry.data.summary}</p>
    <div class="codex-rule"></div>

    {
      entry.data.image && (
        <figure class="codex-entry__media">
          <a
            href={entry.data.image.src}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Open the full-size character file for ${entry.data.name}`}
          >
            <img
              src={entry.data.image.src}
              width={entry.data.image.width}
              height={entry.data.image.height}
              alt={entry.data.imageAlt ?? entry.data.name}
            />
          </a>
          <figcaption class="codex-entry__media-hint">Click to view full size</figcaption>
        </figure>
      )
    }

    <div class="codex-prose">
      <RevealGate tier={tier}>
        <Content />
      </RevealGate>
    </div>

    {
      links.length > 0 && (
        <section class="codex-rel">
          <p class="codex-rel__label">Connected threads</p>
          <div class="codex-rel__list">
            {links.map((link) => (
              <a class="codex-rel__item" href={link.url}>
                {link.label && <span class="codex-rel__rel">{link.label}</span>}
                <span>{link.name}</span>
              </a>
            ))}
          </div>
        </section>
      )
    }

    <a class="codex-back" href={`${base}codex`}>← All entries</a>
  </article>
</CodexLayout>
