---
/**
 * The Interface (backlog Phase 3 #9) — Marcus's character sheet as his implant
 * renders it. Mirrors the /eyes island pattern: Base layout, bespoke scoped
 * styles, a little inline JS for the tab panels and the stat-bar fill. All
 * content comes from the typed `marcusSheet` data, so the LitRPG mechanics are
 * fillable without touching this markup. Kept out of the live nav until the
 * data is real (NAV_PAGES `interface` is `ready: false`).
 */
import Base from '../layouts/Base.astro';
import { marcusSheet as sheet } from '../data/marcus-sheet';

const base = import.meta.env.BASE_URL;
const pct = (s: { value: number; max: number }) => Math.round((s.value / s.max) * 100);
---

<Base
  title="The Interface — Marcus's Character Sheet"
  description="Marcus's stats, skills, and inventory, as his ocular implant renders the Realm into RPG logic."
  ogTitle="The Interface"
>
  <div class="grain"></div>
  <div class="vignette"></div>

  <div class="iface">
    <header class="iface-top">
      <a class="iface-top__home" href={base}>← The Dominion <em>Realm</em></a>
      <nav class="iface-top__nav">
        <a href={`${base}codex/characters/marcus`}>Marcus in the Codex</a>
        <a href={`${base}eyes`}>The Eyes</a>
      </nav>
    </header>

    <main class="iface-wrap">
      {
        sheet.provisional && (
          <p class="iface-provisional">
            Provisional readout — placeholder mechanics, pending the manuscript's true numbers.
          </p>
        )
      }

      <section class="sheet">
        <div class="sheet-frame"></div>

        <div class="sheet-head">
          <div class="sheet-id">
            <span class="sheet-kicker">{sheet.archetype}</span>
            <h1 class="sheet-name">
              {sheet.name}
              {sheet.handle && <em>· {sheet.handle}</em>}
            </h1>
            <p class="sheet-title">{sheet.title}</p>
          </div>
          <div class="sheet-level">
            <span class="sheet-level__label">Level</span>
            <span class="sheet-level__num">{sheet.level}</span>
          </div>
        </div>

        <p class="sheet-readout" data-type>{sheet.readout}</p>

        <div class="sheet-tabs" role="tablist">
          <button class="sheet-tab is-active" role="tab" aria-selected="true" data-tab="stats">
            Stats
          </button>
          <button class="sheet-tab" role="tab" aria-selected="false" data-tab="skills">Skills</button>
          <button class="sheet-tab" role="tab" aria-selected="false" data-tab="inventory">
            Inventory
          </button>
        </div>

        <div class="sheet-panel is-active" data-panel="stats">
          <ul class="stat-list">
            {
              sheet.stats.map((s) => (
                <li class="stat">
                  <div class="stat-row">
                    <span class="stat-label">{s.label}</span>
                    <span class="stat-val">
                      {s.value}
                      <span>/{s.max}</span>
                    </span>
                  </div>
                  <div class="stat-bar">
                    <span class="stat-bar__fill" style={`--pct:${pct(s)}%`} />
                  </div>
                  {s.note && <p class="stat-note">{s.note}</p>}
                </li>
              ))
            }
          </ul>
        </div>

        <div class="sheet-panel" data-panel="skills">
          <ul class="skill-list">
            {
              sheet.skills.map((sk) => (
                <li class="skill">
                  <div class="skill-head">
                    <h3 class="skill-name">{sk.name}</h3>
                    <span class="skill-tier">{sk.tier}</span>
                  </div>
                  <p class="skill-desc">{sk.desc}</p>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="sheet-panel" data-panel="inventory">
          <ul class="inv-grid">
            {
              sheet.inventory.map((it) => (
                <li class="inv-item">
                  <span class="inv-kind">{it.kind}</span>
                  <h3 class="inv-name">{it.name}</h3>
                  {it.note && <p class="inv-note">{it.note}</p>}
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <a class="iface-back" href={`${base}codex/characters/marcus`}>← Read Marcus's full file</a>
    </main>
  </div>

  <script is:inline>
    (() => {
      // ---- Tab panels ----
      const tabs = [...document.querySelectorAll('.sheet-tab')];
      const panels = [...document.querySelectorAll('.sheet-panel')];
      function select(name) {
        for (const t of tabs) {
          const on = t.dataset.tab === name;
          t.classList.toggle('is-active', on);
          t.setAttribute('aria-selected', on ? 'true' : 'false');
        }
        for (const p of panels) p.classList.toggle('is-active', p.dataset.panel === name);
      }
      for (const t of tabs) t.addEventListener('click', () => select(t.dataset.tab));

      // ---- Stat bars fill on load (only if the animation clock advances) ----
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduce) {
        requestAnimationFrame(() =>
          requestAnimationFrame(() => document.querySelector('.sheet')?.classList.add('armed')),
        );
      } else {
        document.querySelector('.sheet')?.classList.add('armed');
      }
    })();
  </script>
</Base>

<style>
  .iface {
    max-width: 880px;
    margin: 0 auto;
    padding: 0 clamp(20px, 5vw, 56px) 80px;
    position: relative;
    z-index: 1;
  }
  .iface-top {
    display: flex;
    align-items: center;
    gap: 18px 30px;
    flex-wrap: wrap;
    padding: 26px 0 24px;
    border-bottom: 1px solid var(--line-soft);
    margin-bottom: clamp(40px, 7vw, 72px);
  }
  .iface-top__home {
    font-family: var(--serif-display);
    font-size: 1.05rem;
    color: var(--ink-dim);
    text-decoration: none;
    transition: color 0.35s var(--ease);
  }
  .iface-top__home em {
    font-style: italic;
    color: var(--gold-bright);
  }
  .iface-top__home:hover {
    color: var(--ink);
  }
  .iface-top__nav {
    display: flex;
    gap: 22px;
    margin-left: auto;
  }
  .iface-top__nav a {
    font-family: var(--mono);
    font-size: 0.66rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-faint);
    text-decoration: none;
    transition: color 0.35s var(--ease);
  }
  .iface-top__nav a:hover {
    color: #4fd6e0;
  }

  .iface-provisional {
    margin-bottom: 26px;
    padding: 12px 18px;
    border: 1px solid rgba(79, 214, 224, 0.3);
    border-radius: var(--radius-md);
    background: rgba(79, 214, 224, 0.05);
    font-family: var(--mono);
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #8fdfe6;
  }

  /* ---- The sheet (HUD) ---- */
  .sheet {
    position: relative;
    border: 1px solid rgba(79, 214, 224, 0.22);
    border-radius: var(--radius-lg);
    padding: clamp(26px, 5vw, 48px);
    background:
      radial-gradient(120% 90% at 50% 0%, rgba(79, 214, 224, 0.07), transparent 60%),
      var(--bg-panel);
    overflow: hidden;
  }
  .sheet-frame {
    position: absolute;
    inset: 10px;
    border: 1px solid rgba(79, 214, 224, 0.1);
    border-radius: var(--radius-md);
    pointer-events: none;
  }

  .sheet-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
  }
  .sheet-kicker {
    font-family: var(--mono);
    font-size: 0.6rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: #4fd6e0;
    display: block;
    margin-bottom: 12px;
  }
  .sheet-name {
    font-family: var(--serif-display);
    font-weight: 500;
    font-size: clamp(2rem, 5vw, 3rem);
    line-height: 1.04;
    color: var(--ink);
  }
  .sheet-name em {
    font-style: italic;
    font-size: 0.5em;
    color: var(--ink-dim);
  }
  .sheet-title {
    margin-top: 10px;
    font-style: italic;
    color: var(--ink-dim);
    max-width: 46ch;
    text-wrap: pretty;
  }
  .sheet-level {
    text-align: center;
    flex-shrink: 0;
    border: 1px solid rgba(79, 214, 224, 0.25);
    border-radius: var(--radius-md);
    padding: 10px 18px;
  }
  .sheet-level__label {
    display: block;
    font-family: var(--mono);
    font-size: 0.52rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .sheet-level__num {
    font-family: var(--serif-display);
    font-size: 2.2rem;
    color: #4fd6e0;
    line-height: 1.1;
  }

  .sheet-readout {
    margin: clamp(22px, 4vw, 34px) 0;
    padding: 12px 0;
    border-top: 1px solid var(--line-soft);
    border-bottom: 1px solid var(--line-soft);
    font-family: var(--mono);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    color: #8fdfe6;
  }

  /* ---- Tabs ---- */
  .sheet-tabs {
    display: flex;
    gap: 8px;
    margin-bottom: 26px;
    flex-wrap: wrap;
  }
  .sheet-tab {
    font-family: var(--mono);
    font-size: 0.62rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-dim);
    background: transparent;
    border: 1px solid var(--line-soft);
    border-radius: 999px;
    padding: 9px 18px;
    cursor: pointer;
    transition:
      color 0.3s var(--ease),
      border-color 0.3s var(--ease),
      background 0.3s var(--ease);
  }
  .sheet-tab:hover {
    color: var(--ink);
    border-color: var(--line);
  }
  .sheet-tab.is-active {
    color: #061015;
    background: #4fd6e0;
    border-color: #4fd6e0;
  }

  /* ---- Panels: all visible without JS; JS narrows to the active one. ---- */
  .sheet-panel {
    display: block;
  }
  .sheet-panel + .sheet-panel {
    margin-top: 30px;
  }
  /* Once JS marks a tab active, only the active panel shows. */
  .sheet.armed .sheet-panel:not(.is-active) {
    display: none;
  }

  /* ---- Stats ---- */
  .stat-list {
    list-style: none;
    display: grid;
    gap: 22px;
  }
  .stat-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 8px;
  }
  .stat-label {
    font-family: var(--mono);
    font-size: 0.66rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .stat-val {
    font-family: var(--serif-display);
    color: #4fd6e0;
    font-size: 1.1rem;
  }
  .stat-val span {
    color: var(--ink-faint);
    font-size: 0.8em;
  }
  .stat-bar {
    height: 6px;
    border-radius: 999px;
    background: rgba(236, 231, 218, 0.08);
    overflow: hidden;
  }
  .stat-bar__fill {
    display: block;
    height: 100%;
    width: var(--pct);
    border-radius: 999px;
    background: linear-gradient(90deg, #4fd6e0, #5b8def);
    box-shadow: 0 0 12px -2px #4fd6e0;
  }
  .sheet.armed .stat-bar__fill {
    width: 0;
    animation: stat-fill 1.1s var(--ease) forwards;
  }
  @keyframes stat-fill {
    to {
      width: var(--pct);
    }
  }
  .stat-note {
    margin-top: 8px;
    font-weight: 300;
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--ink-dim);
    text-wrap: pretty;
  }

  /* ---- Skills ---- */
  .skill-list {
    list-style: none;
    display: grid;
    gap: 18px;
  }
  .skill {
    padding: 18px 20px;
    border: 1px solid var(--line-soft);
    border-radius: var(--radius-md);
    background: rgba(8, 9, 16, 0.4);
  }
  .skill-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    margin-bottom: 8px;
  }
  .skill-name {
    font-family: var(--serif-display);
    font-size: 1.25rem;
    color: var(--ink);
  }
  .skill-tier {
    font-family: var(--mono);
    font-size: 0.56rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #4fd6e0;
    white-space: nowrap;
  }
  .skill-desc {
    font-weight: 300;
    font-size: 0.98rem;
    line-height: 1.6;
    color: var(--ink-dim);
    text-wrap: pretty;
  }

  /* ---- Inventory ---- */
  .inv-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 14px;
  }
  .inv-item {
    padding: 16px 18px;
    border: 1px solid var(--line-soft);
    border-radius: var(--radius-md);
    background: rgba(8, 9, 16, 0.4);
  }
  .inv-kind {
    font-family: var(--mono);
    font-size: 0.54rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .inv-name {
    font-family: var(--serif-display);
    font-size: 1.15rem;
    color: var(--ink);
    margin: 8px 0 6px;
  }
  .inv-note {
    font-weight: 300;
    font-size: 0.88rem;
    line-height: 1.5;
    color: var(--ink-dim);
    text-wrap: pretty;
  }

  .iface-back {
    display: inline-block;
    margin-top: clamp(36px, 6vw, 52px);
    font-family: var(--mono);
    font-size: 0.64rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-faint);
    text-decoration: none;
    transition: color 0.35s var(--ease);
  }
  .iface-back:hover {
    color: #4fd6e0;
  }

  @media (prefers-reduced-motion: reduce) {
    .sheet.armed .stat-bar__fill {
      animation: none;
      width: var(--pct);
    }
  }
</style>
