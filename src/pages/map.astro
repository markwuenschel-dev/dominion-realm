---
/**
 * The Map of the Realm (content-depth backlog #4) — now a procedural,
 * themeable SVG instead of a pending raster slot.
 *
 * Everything is computed from `realmMap` (src/data/realm-map.ts): Eriadne at the
 * convergence, eight ley "threads" reaching in from a ring, the ruins-portal on
 * the city-fringe, and the two threat-frontiers as edge washes. The thread hues
 * reuse the Neurochromatic Eyes' spectral palette so the map and /eyes read as
 * one world.
 *
 * Design notes:
 *  - Zero dependencies; geometry is laid out server-side and emitted as static
 *    SVG (same approach as /relationships). A tiny inline script only does
 *    legend↔thread cross-highlighting — the page is fully functional without it.
 *  - Themed via the design tokens; per-thread colour comes from an inline
 *    `--hue` custom property (mirrors the homepage power-rail's `--node-glow`).
 *  - Hover/focus lights a thread in pure CSS; motion (the inward flow, the hub
 *    pulse) is gated behind `prefers-reduced-motion`.
 *  - The legend below is the no-JS / screen-reader fallback and a real key.
 */
import ReadingLayout from '../layouts/ReadingLayout.astro';
import { realmMap, type LeyLine } from '../data/realm-map';

const base = import.meta.env.BASE_URL;
const { hub, ruins, threats, leyLines } = realmMap;
const codex = (href?: string) => (href ? `${base}codex/${href}` : undefined);

// ---- Geometry. A radial convergence: Eriadne at center, threads on a ring. ----
const VB = { w: 960, h: 720 };
const C = { x: 480, y: 360 };
const RING = { rx: 332, ry: 246 };

interface Node {
  ley: LeyLine;
  key: string;
  x: number;
  y: number;
  /** Quadratic path from the ring node into the hub. */
  d: string;
  anchor: 'start' | 'middle' | 'end';
  lx: number;
  ly: number;
}

const nodes: Node[] = leyLines.map((ley, i) => {
  // Start at the top (−90°) and walk clockwise.
  const a = -Math.PI / 2 + (i / leyLines.length) * Math.PI * 2;
  const x = C.x + Math.cos(a) * RING.rx;
  const y = C.y + Math.sin(a) * RING.ry;

  // Gentle arc toward the hub: control point = midpoint nudged perpendicular,
  // alternating side per index so neighbouring threads bow apart, not together.
  const mx = (x + C.x) / 2;
  const my = (y + C.y) / 2;
  const dx = C.x - x;
  const dy = C.y - y;
  const len = Math.hypot(dx, dy) || 1;
  const bow = 24 * (i % 2 === 0 ? 1 : -1);
  const cx = mx + (-dy / len) * bow;
  const cy = my + (dx / len) * bow;
  const d = `M${x.toFixed(1)},${y.toFixed(1)} Q${cx.toFixed(1)},${cy.toFixed(1)} ${C.x},${C.y}`;

  // Label sits just outside the node, anchored away from center.
  const cosA = Math.cos(a);
  const anchor = cosA > 0.34 ? 'start' : cosA < -0.34 ? 'end' : 'middle';
  const lx = x + (anchor === 'start' ? 14 : anchor === 'end' ? -14 : 0);
  const ly = Math.abs(cosA) <= 0.34 ? (Math.sin(a) < 0 ? y - 16 : y + 25) : y + 5;

  return { ley, key: ley.element.toLowerCase(), x, y, d, anchor, lx, ly };
});

// Landmarks for the textual key below the map (swatch colour each).
const landmarks = [
  { ...hub, color: 'var(--gold)' },
  { ...ruins, color: '#9b6cf0' },
  { ...threats[0], color: '#6f6a86' }, // N'hal
  { ...threats[1], color: '#8fb45e' }, // Xyloryn
];

// A few decorative motes so the threat-frontiers read as living, not flat.
const swarm = [
  [786, 552],
  [858, 588],
  [812, 624],
  [880, 540],
  [840, 660],
  [762, 600],
  [902, 612],
];
const denature = [
  [96, 96],
  [150, 78],
  [78, 150],
  [132, 132],
  [188, 108],
  [108, 188],
];
---

<ReadingLayout
  title="The Map"
  description="A map of the Realm — Eriadne at the convergence of the eight elemental ley lines, the ruins-portal at its edge, and the frontiers the threats come from."
>
  <div class="map-page">
    <header class="map-head">
      <span class="reading-article__kicker">Cartography of the Realm</span>
      <h1 class="reading-article__title">The <em>Map</em></h1>
      <p class="reading-article__summary">
        Eriadne at the convergence of the eight ley lines — and what spreads out from it.
      </p>
      <div class="reading-article__rule"></div>
    </header>

    <figure class="realm-map">
      <svg
        class="realm-map__svg"
        viewBox={`0 0 ${VB.w} ${VB.h}`}
        role="img"
        aria-labelledby="realmMapTitle realmMapDesc"
        xmlns="http://www.w3.org/2000/svg"
      >
        <title id="realmMapTitle">A map of the Realm</title>
        <desc id="realmMapDesc">
          Eriadne sits at the center, where eight elemental ley threads converge; the ruins-portal
          lies on its outskirts, with the N'hal frontier to the northwest and the Xyloryn swarm to
          the southeast.
        </desc>

        <defs>
          <radialGradient id="rm-bg" cx="50%" cy="50%" r="72%">
            <stop offset="0%" stop-color="#161a2b"></stop>
            <stop offset="55%" stop-color="#0d0f1a"></stop>
            <stop offset="100%" stop-color="#080910"></stop>
          </radialGradient>
          <radialGradient id="rm-hub-glow" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="#c8a86a" stop-opacity="0.5"></stop>
            <stop offset="55%" stop-color="#c8a86a" stop-opacity="0.12"></stop>
            <stop offset="100%" stop-color="#c8a86a" stop-opacity="0"></stop>
          </radialGradient>
          <radialGradient id="rm-portal" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="#9b6cf0" stop-opacity="0.32"></stop>
            <stop offset="65%" stop-color="#5b8def" stop-opacity="0.06"></stop>
            <stop offset="100%" stop-color="#9b6cf0" stop-opacity="0"></stop>
          </radialGradient>
          <radialGradient id="rm-nhal" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="#04050a" stop-opacity="0.66"></stop>
            <stop offset="52%" stop-color="#090a16" stop-opacity="0.32"></stop>
            <stop offset="78%" stop-color="#3a3a5e" stop-opacity="0.14"></stop>
            <stop offset="100%" stop-color="#3a3a5e" stop-opacity="0"></stop>
          </radialGradient>
          <radialGradient id="rm-xyloryn" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="#5a7233" stop-opacity="0.2"></stop>
            <stop offset="55%" stop-color="#3f4f26" stop-opacity="0.1"></stop>
            <stop offset="100%" stop-color="#3f4f26" stop-opacity="0"></stop>
          </radialGradient>
        </defs>

        <!-- ── Field ────────────────────────────────────────────── -->
        <rect x="0" y="0" width={VB.w} height={VB.h} fill="url(#rm-bg)"></rect>

        <!-- ── Threat frontiers (washes, behind the cartography) ── -->
        <g class="rm-washes" aria-hidden="true">
          <ellipse cx="132" cy="120" rx="270" ry="226" fill="url(#rm-nhal)"></ellipse>
          <ellipse cx="836" cy="600" rx="272" ry="218" fill="url(#rm-xyloryn)"></ellipse>
          {
            denature.map(([x, y]) => (
              <line class="rm-denature" x1={x - 5} y1={y - 5} x2={x + 5} y2={y + 5} />
            ))
          }
          {swarm.map(([x, y]) => <circle class="rm-swarm" cx={x} cy={y} r="1.8" />)}
        </g>

        <!-- ── Graticule: faint guide rings around the convergence ── -->
        <g class="rm-graticule" aria-hidden="true">
          <ellipse cx={C.x} cy={C.y} rx={RING.rx} ry={RING.ry}></ellipse>
          <ellipse cx={C.x} cy={C.y} rx={RING.rx * 0.66} ry={RING.ry * 0.66}></ellipse>
          <ellipse cx={C.x} cy={C.y} rx={RING.rx * 0.34} ry={RING.ry * 0.34}></ellipse>
        </g>

        <!-- ── The eight ley threads ───────────────────────────── -->
        {
          nodes.map((n, i) => (
            <g class="ley" data-key={n.key} style={`--hue:${n.ley.hue};--i:${i}`}>
              <path class="ley-base" d={n.d} />
              <path class="ley-flow" d={n.d} />
              <circle class="ley-node-ring" cx={n.x} cy={n.y} r="6" />
              <circle class="ley-node-dot" cx={n.x} cy={n.y} r="2.6" />
              <text class="ley-label" x={n.lx} y={n.ly} text-anchor={n.anchor}>
                {n.ley.element}
              </text>
            </g>
          ))
        }

        <!-- ── Eriadne — the convergence ───────────────────────── -->
        <g class="hub" aria-hidden="true">
          <circle cx={C.x} cy={C.y} r="58" fill="url(#rm-hub-glow)"></circle>
          <circle cx={C.x} cy={C.y} r="22" fill="url(#rm-portal)"></circle>
          <circle
            class="hub-ring hub-ring--spin"
            cx={C.x}
            cy={C.y}
            r="34"
            style={`transform-origin:${C.x}px ${C.y}px`}></circle>
          <circle class="hub-ring" cx={C.x} cy={C.y} r="22"></circle>
          <circle class="hub-ring hub-ring--inner" cx={C.x} cy={C.y} r="12"></circle>
          <circle class="hub-core" cx={C.x} cy={C.y} r="5.5"></circle>
        </g>
        <a
          class="rm-mark"
          href={codex(hub.href)}
          aria-label={`Eriadne — ${hub.kind} (open in codex)`}
        >
          <rect class="rm-mark__bg" x="416" y="392" width="128" height="34" rx="4"></rect>
          <text class="hub-name" x={C.x} y="409" text-anchor="middle">Eriadne</text>
          <text class="hub-kicker" x={C.x} y="421" text-anchor="middle">THE THREAD CITY</text>
        </a>

        <!-- ── The ruins-portal on the city-fringe ─────────────── -->
        <a
          class="rm-mark ruin"
          href={codex(ruins.href)}
          aria-label={`The Ruins — ${ruins.kind} (open in codex)`}
        >
          <line class="ruin-tether" x1="372" y1="446" x2={C.x} y2={C.y}></line>
          <circle class="ruin-portal" cx="372" cy="446" r="9"></circle>
          <circle class="ruin-ring" cx="372" cy="446" r="14"></circle>
          <text class="ruin-name" x="372" y="478" text-anchor="middle">The Ruins</text>
          <text class="ruin-kicker" x="372" y="490" text-anchor="middle">THE CROSSING</text>
        </a>

        <!-- ── Threat labels (links to their codex files) ──────── -->
        <a
          class="rm-mark threat threat--nhal"
          href={codex(threats[0].href)}
          aria-label={`${threats[0].name} — ${threats[0].kind} (open in codex)`}
        >
          <text class="threat-name" x="64" y="92" text-anchor="start">The N'hal</text>
          <text class="threat-sub" x="64" y="106" text-anchor="start">the interface goes dark</text>
        </a>
        <a
          class="rm-mark threat threat--xyloryn"
          href={codex(threats[1].href)}
          aria-label={`${threats[1].name} — ${threats[1].kind} (open in codex)`}
        >
          <text class="threat-name" x="896" y="650" text-anchor="end">The Xyloryn</text>
          <text class="threat-sub" x="896" y="664" text-anchor="end">the adapting swarm</text>
        </a>

        <!-- ── Cartographic chrome ─────────────────────────────── -->
        <g class="rm-frame" aria-hidden="true">
          <rect x="12" y="12" width="936" height="696" rx="6"></rect>
          <path d="M22,42 V22 H42"></path>
          <path d="M918,22 H938 V42"></path>
          <path d="M938,678 V698 H918"></path>
          <path d="M42,698 H22 V678"></path>
          <g class="rm-compass" transform="translate(892,84)">
            <circle r="16"></circle>
            <path class="rm-compass__n" d="M0,-12 L4,0 L0,5 L-4,0 Z"></path>
            <path class="rm-compass__s" d="M0,12 L4,0 L0,-5 L-4,0 Z"></path>
            <text class="rm-compass__lbl" x="0" y="-21" text-anchor="middle">N</text>
          </g>
          <text class="rm-cartouche" x="30" y="694">
            THE DOMINION REALM — A CARTOGRAPHY OF THE EIGHT THREADS
          </text>
        </g>
      </svg>

      <figcaption class="realm-map__cap">
        A cartographer's rendering — the eight threads as Eriadne's scholars name them. Hover a
        thread to trace it home.
      </figcaption>
    </figure>

    <section class="map-key" aria-label="Map legend">
      <h2 class="map-key__title">The Eight Threads</h2>
      <ul class="ley-legend">
        {
          nodes.map((n) => (
            <li class="ley-legend__item" data-key={n.key} style={`--hue:${n.ley.hue}`}>
              <span class="ley-legend__swatch" aria-hidden="true" />
              <div>
                <span class="ley-legend__el">{n.ley.element}</span>
                <span class="ley-legend__name">{n.ley.name}</span>
                <p class="ley-legend__gloss">{n.ley.gloss}</p>
              </div>
            </li>
          ))
        }
      </ul>

      <h2 class="map-key__title">Landmarks &amp; Frontiers</h2>
      <ul class="land-legend">
        {
          landmarks.map((m) => (
            <li class="land-legend__item" style={`--swatch:${m.color}`}>
              <span class="land-legend__swatch" aria-hidden="true" />
              <div>
                <span class="land-legend__name">
                  {codex(m.href) ? <a href={codex(m.href)}>{m.name}</a> : m.name}
                </span>
                <span class="land-legend__kind">{m.kind}</span>
                <p class="land-legend__gloss">{m.gloss}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <a class="reading-back" href={base}>← Back to The Dominion Realm</a>
  </div>

  <script is:inline>
    // Progressive enhancement: cross-highlight legend ↔ thread on hover. The map
    // is fully usable without this — threads also self-light via CSS :hover.
    (() => {
      const threads = new Map();
      document.querySelectorAll('.ley[data-key]').forEach((g) => threads.set(g.dataset.key, g));
      const items = new Map();
      document
        .querySelectorAll('.ley-legend__item[data-key]')
        .forEach((li) => items.set(li.dataset.key, li));

      const link = (key, on) => {
        threads.get(key)?.classList.toggle('lit', on);
        items.get(key)?.classList.toggle('lit', on);
      };

      threads.forEach((g, key) => {
        g.addEventListener('mouseenter', () => link(key, true));
        g.addEventListener('mouseleave', () => link(key, false));
      });
      items.forEach((li, key) => {
        li.addEventListener('mouseenter', () => link(key, true));
        li.addEventListener('mouseleave', () => link(key, false));
      });
    })();
  </script>
</ReadingLayout>

<style>
  .map-page {
    max-width: 980px;
    margin: 0 auto;
  }
  .map-head {
    max-width: 720px;
    margin: 0 auto clamp(28px, 5vw, 44px);
  }

  /* ---- The map figure ---- */
  .realm-map {
    margin: 0;
  }
  .realm-map__svg {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--line-soft);
    border-radius: var(--radius-lg);
    background: var(--bg);
    overflow: hidden;
  }
  .realm-map__cap {
    margin-top: 14px;
    text-align: center;
    font-family: var(--mono);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-faint);
    text-wrap: pretty;
  }

  /* ---- Threat frontiers ---- */
  .rm-denature {
    stroke: #6f6a86;
    stroke-width: 1.1;
    opacity: 0.45;
  }
  .rm-swarm {
    fill: #8fb45e;
    opacity: 0.4;
  }

  /* ---- Graticule ---- */
  .rm-graticule ellipse {
    fill: none;
    stroke: var(--line-soft);
    stroke-width: 1;
    stroke-dasharray: 2 7;
  }

  /* ---- Ley threads ---- */
  .ley-base {
    fill: none;
    stroke: var(--hue);
    stroke-width: 1.3;
    stroke-linecap: round;
    opacity: 0.34;
    transition:
      opacity 0.4s var(--ease),
      stroke-width 0.4s var(--ease);
  }
  .ley-flow {
    fill: none;
    stroke: var(--hue);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-dasharray: 1.5 15;
    opacity: 0.85;
    filter: drop-shadow(0 0 3px var(--hue));
    animation: ley-flow 2.6s linear infinite;
    animation-delay: calc(var(--i) * -0.32s);
    transition: opacity 0.4s var(--ease);
  }
  @keyframes ley-flow {
    to {
      stroke-dashoffset: -33;
    }
  }
  .ley-node-ring {
    fill: none;
    stroke: var(--hue);
    stroke-width: 1.4;
    opacity: 0.85;
    transition:
      r 0.35s var(--ease),
      opacity 0.35s var(--ease);
  }
  .ley-node-dot {
    fill: var(--hue);
    filter: drop-shadow(0 0 4px var(--hue));
    transition: r 0.35s var(--ease);
  }
  .ley-label {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    fill: var(--hue);
    opacity: 0.78;
    transition: opacity 0.35s var(--ease);
  }
  /* Hover (mouse) or .lit (cross-highlight from the legend) brighten a thread. */
  .ley:hover .ley-base,
  .ley.lit .ley-base {
    opacity: 0.95;
    stroke-width: 2;
  }
  .ley:hover .ley-flow,
  .ley.lit .ley-flow {
    opacity: 1;
    stroke-width: 2.6;
  }
  .ley:hover .ley-node-ring,
  .ley.lit .ley-node-ring {
    r: 8.5px;
    opacity: 1;
  }
  .ley:hover .ley-node-dot,
  .ley.lit .ley-node-dot {
    r: 4px;
  }
  .ley:hover .ley-label,
  .ley.lit .ley-label {
    opacity: 1;
  }

  /* ---- Eriadne hub ---- */
  .hub-ring {
    fill: none;
    stroke: var(--gold);
    stroke-width: 1.1;
    opacity: 0.6;
  }
  .hub-ring--inner {
    opacity: 0.8;
  }
  .hub-ring--spin {
    stroke-dasharray: 3 6;
    opacity: 0.5;
    animation: hub-spin 64s linear infinite;
  }
  @keyframes hub-spin {
    to {
      transform: rotate(360deg);
    }
  }
  .hub-core {
    fill: var(--gold-bright);
    filter: drop-shadow(0 0 7px var(--gold-bright));
    animation: hub-pulse 3.6s ease-in-out infinite;
  }
  @keyframes hub-pulse {
    0%,
    100% {
      opacity: 0.82;
    }
    50% {
      opacity: 1;
    }
  }

  /* ---- Marker labels (links) ---- */
  .rm-mark {
    cursor: pointer;
  }
  .rm-mark__bg {
    fill: rgba(8, 9, 16, 0.62);
  }
  .hub-name {
    font-family: var(--serif-display);
    font-size: 18px;
    fill: var(--ink);
    transition: fill 0.35s var(--ease);
  }
  .hub-kicker {
    font-family: var(--mono);
    font-size: 8px;
    letter-spacing: 0.26em;
    fill: var(--gold);
  }
  .rm-mark:hover .hub-name {
    fill: var(--gold-bright);
  }

  .ruin-tether {
    stroke: var(--ink-faint);
    stroke-width: 1;
    stroke-dasharray: 2 5;
    opacity: 0.5;
  }
  .ruin-portal {
    fill: rgba(155, 108, 240, 0.16);
    stroke: rgba(155, 108, 240, 0.5);
    stroke-width: 1;
  }
  .ruin-ring {
    fill: none;
    stroke: var(--ink-dim);
    stroke-width: 1.2;
    stroke-dasharray: 4 5;
    opacity: 0.6;
    transition:
      stroke 0.35s var(--ease),
      opacity 0.35s var(--ease);
  }
  .ruin-name {
    font-family: var(--serif-display);
    font-size: 13px;
    fill: var(--ink-dim);
    transition: fill 0.35s var(--ease);
  }
  .ruin-kicker {
    font-family: var(--mono);
    font-size: 7.5px;
    letter-spacing: 0.22em;
    fill: var(--ink-faint);
  }
  .ruin:hover .ruin-ring {
    stroke: #9b6cf0;
    opacity: 1;
  }
  .ruin:hover .ruin-name {
    fill: var(--ink);
  }

  /* ---- Threat labels ---- */
  .threat-name {
    font-family: var(--serif-display);
    font-size: 14px;
    transition: fill 0.35s var(--ease);
  }
  .threat-sub {
    font-family: var(--mono);
    font-size: 7.5px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .threat--nhal .threat-name {
    fill: #8f89a6;
  }
  .threat--nhal .threat-sub {
    fill: #6f6a86;
  }
  .threat--xyloryn .threat-name {
    fill: #a6c479;
  }
  .threat--xyloryn .threat-sub {
    fill: #8fb45e;
  }
  .threat--nhal:hover .threat-name {
    fill: #c4bfdb;
  }
  .threat--xyloryn:hover .threat-name {
    fill: #c8e3a0;
  }

  /* ---- Frame / compass / cartouche ---- */
  .rm-frame rect,
  .rm-frame path {
    fill: none;
    stroke: var(--line-soft);
    stroke-width: 1;
  }
  .rm-frame rect {
    stroke: var(--line);
    opacity: 0.4;
  }
  .rm-compass circle {
    fill: none;
    stroke: var(--line);
  }
  .rm-compass__n {
    fill: var(--gold);
  }
  .rm-compass__s {
    fill: var(--ink-faint);
  }
  .rm-compass__lbl {
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 0.1em;
    fill: var(--gold);
  }
  .rm-cartouche {
    font-family: var(--mono);
    font-size: 8px;
    letter-spacing: 0.22em;
    fill: var(--ink-faint);
  }

  /* =====================================================================
     Legend (also the no-JS / screen-reader fallback + real key)
     ===================================================================== */
  .map-key {
    margin-top: clamp(36px, 6vw, 56px);
  }
  .map-key__title {
    font-family: var(--mono);
    font-size: 0.66rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--gold);
    margin: clamp(28px, 5vw, 40px) 0 18px;
  }
  .map-key__title:first-child {
    margin-top: 0;
  }
  .ley-legend,
  .land-legend {
