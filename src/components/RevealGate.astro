---
/**
 * Gates a section of an entry behind a reveal tier (ADR-0004).
 *
 * Teaser content renders normally — it's the safe baseline and must be readable
 * with no JavaScript. Higher-tier content is emitted into an inert <template>,
 * so at the default Teaser level the words are genuinely *absent from the live
 * DOM* (not merely hidden): not selectable, not in the accessibility tree, not
 * found by querySelector. The RevealToggle controller clones a template's
 * contents into the mount only once the reader raises their level to or past
 * the gate's tier, and re-seals it if they lower it again.
 *
 * Caveat: sealed content still exists in the page's HTML *source*. That's the
 * honest limit of client-side gating on a fully static site (ADR-0001); true
 * server-side withholding would require per-tier builds. This protects against
 * accidental spoilers, not a determined view-source.
 */
import type { RevealTier } from '../lib/reveal';
import { TIER_LABELS } from '../lib/reveal';

interface Props {
  /** Minimum reveal level required to read this section. */
  tier: RevealTier;
  /** Optional custom message for the sealed placeholder. */
  label?: string;
}

const { tier, label } = Astro.props;
const isBaseline = tier === 'teaser';
const sealedMessage = label ?? `Raise your reveal level to ${TIER_LABELS[tier]} to read this.`;
---
{
  isBaseline ? (
    <div class="reveal-gate" data-reveal-tier={tier}>
      <slot />
    </div>
  ) : (
    <div class="reveal-gate is-sealed" data-reveal-tier={tier}>
      <p class="reveal-gate__sealed" hidden>
        <span class="reveal-gate__lock">Sealed · {TIER_LABELS[tier]}</span>
        <span class="reveal-gate__msg">{sealedMessage}</span>
      </p>
      <div class="reveal-gate__mount" />
      <template data-reveal-content>
        <slot />
      </template>
    </div>
  )
}
