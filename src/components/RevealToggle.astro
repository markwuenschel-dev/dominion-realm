---
/**
 * The global reveal-level control (ADR-0004). A four-way segmented switch that
 * persists the reader's choice in localStorage and drives every <RevealGate> on
 * the page. Defaults to Teaser; degrades to a static, spoiler-safe page when JS
 * is unavailable (the gates simply stay sealed).
 *
 * The page may contain more than one instance (e.g. sidebar + mobile); the
 * controller wires them all and keeps their state in sync.
 */
import { REVEAL_TIERS, TIER_LABELS, TIER_DESCRIPTIONS, DEFAULT_TIER } from '../lib/reveal';
---

<fieldset class="reveal-toggle" aria-label="Spoiler reveal level">
  <legend class="reveal-toggle__legend">Reveal</legend>
  <div class="reveal-toggle__options" role="radiogroup">
    {
      REVEAL_TIERS.map((tier) => (
        <button
          type="button"
          class="reveal-toggle__btn"
          role="radio"
          data-reveal-set={tier}
          aria-checked={tier === DEFAULT_TIER ? 'true' : 'false'}
          title={TIER_DESCRIPTIONS[tier]}
        >
          {TIER_LABELS[tier]}
        </button>
      ))
    }
  </div>
</fieldset>

<script>
  import {
    REVEAL_STORAGE_KEY,
    DEFAULT_TIER,
    parseTier,
    isRevealed,
    type RevealTier,
  } from '../lib/reveal';

  function readLevel(): RevealTier {
    try {
      return parseTier(localStorage.getItem(REVEAL_STORAGE_KEY));
    } catch {
      return DEFAULT_TIER;
    }
  }

  function applyReveal(level: RevealTier): void {
    document.documentElement.dataset.reveal = level;

    // Keep every toggle instance's pressed state in sync.
    document.querySelectorAll<HTMLButtonElement>('[data-reveal-set]').forEach((btn) => {
      btn.setAttribute('aria-checked', btn.dataset.revealSet === level ? 'true' : 'false');
    });

    // Open or re-seal each gated section.
    document.querySelectorAll<HTMLElement>('.reveal-gate').forEach((gate) => {
      const tpl = gate.querySelector<HTMLTemplateElement>('template[data-reveal-content]');
      const mount = gate.querySelector<HTMLElement>('.reveal-gate__mount');
      if (!tpl || !mount) return; // baseline (Teaser) gates are always open

      const required = parseTier(gate.dataset.revealTier);
      const note = gate.querySelector<HTMLElement>('.reveal-gate__sealed');

      if (isRevealed(required, level)) {
        if (mount.childElementCount === 0) {
          mount.appendChild(tpl.content.cloneNode(true));
        }
        gate.classList.remove('is-sealed');
        gate.classList.add('is-open');
        if (note) note.hidden = true;
      } else {
        mount.replaceChildren();
        gate.classList.add('is-sealed');
        gate.classList.remove('is-open');
        if (note) note.hidden = false;
      }
    });
  }

  function setLevel(level: RevealTier): void {
    try {
      localStorage.setItem(REVEAL_STORAGE_KEY, level);
    } catch {
      /* storage blocked — still apply for this session */
    }
    applyReveal(level);
  }

  document.querySelectorAll<HTMLButtonElement>('[data-reveal-set]').forEach((btn) => {
    btn.addEventListener('click', () => setLevel(parseTier(btn.dataset.revealSet)));
  });

  // Restore the reader's persisted choice on load.
  applyReveal(readLevel());
</script>
