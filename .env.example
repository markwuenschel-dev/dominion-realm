# Environment variables for The Dominion Realm (Next.js on AWS EC2 — ADR-0010/0012).
#
# DO NOT commit real values. Copy this file to `.env` (which is gitignored) for
# local use, and set the same vars in the EC2 deploy env (`env/dominion-realm.env`
# on the host) for production.

# --- Keystatic CMS — GitHub storage mode (ADR-0009) ---
#
# These power the GitHub-App OAuth flow that lets the hosted admin (/keystatic)
# commit straight to this repo. Required on the EC2 deploy and for cloud
# editing during local dev.
#
# How to obtain them: create a GitHub App (see docs/adr/0009-cms-keystatic.md).
#   - CLIENT_ID / CLIENT_SECRET come from that GitHub App.
#   - KEYSTATIC_SECRET is any random 32+ char string you generate, e.g.
#       openssl rand -hex 32
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=

# Set to `true` ONLY on the deployed instance to switch the browser editor into
# GitHub mode. It's a NEXT_PUBLIC flag on purpose: the /keystatic UI is a client
# bundle and can't read the server-only secrets above, so it needs this public
# flag to know to show the GitHub sign-in. Leave it unset in CI and local dev, so
# `next build` uses `local` storage and never evaluates github mode without secrets.
NEXT_PUBLIC_KEYSTATIC_GITHUB=

# --- Public, build-time IDs (safe to expose; baked into the client bundle) ---
#
# Mirror these as repo Variables so CI builds match production (see
# .github/workflows/ci.yml). Leave blank to disable the matching feature.
#   - NEXT_PUBLIC_SITE_URL: canonical origin, e.g. https://thedominionrealm.com
#   - NEXT_PUBLIC_GA4_ID: Google Analytics 4 measurement ID (G-XXXXXXX)
#   - NEXT_PUBLIC_KIT_FORM_ID: Kit (ConvertKit) newsletter form ID
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_KIT_FORM_ID=

# --- Sanity media layer (ADR-0011) ---
#
# Sanity holds the pictures (Subjects, galleries, cover) and the Studio at /studio.
# The project ID and dataset are PUBLIC (baked into the client bundle); a sensible
# fallback is hardcoded in src/sanity/env.ts, so these are optional overrides.
#   - NEXT_PUBLIC_SANITY_PROJECT_ID: the Sanity project ID (e.g. zwq04v8v)
#   - NEXT_PUBLIC_SANITY_DATASET:    dataset name (default: production)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
#
# SECRET — used only by the server-side sync/migration/backup scripts (Phase 2+),
# never in the client bundle. Create it in Sanity → API → Tokens with the EDITOR
# role (see docs/adr/0011-media-layer-sanity.md). Do NOT commit a real value.
SANITY_API_WRITE_TOKEN=
#
# SECRET — a random string shared between the Sanity webhook and the site's
# revalidate route (Phase 3), so only Sanity can trigger a live refresh.
#   e.g. openssl rand -hex 32
SANITY_REVALIDATE_SECRET=

# --- Buy / pre-order CTA (Tier 3) ---
#
# There is no storefront yet, so the buy/pre-order button is configuration-driven
# (see src/lib/cta.ts). Leave NEXT_PUBLIC_BUY_URL blank and the homepage + /read
# show a graceful "Coming soon — join the list" prompt pointing at the newsletter.
# Set it to a real product/checkout URL (Amazon, Bookshop, store, pre-order page)
# to light up a prominent outbound buy button.
#   - NEXT_PUBLIC_BUY_URL:   destination URL for the buy/pre-order button.
#   - NEXT_PUBLIC_BUY_LABEL: optional button text (default "Buy / Pre-order the Book").
NEXT_PUBLIC_BUY_URL=
NEXT_PUBLIC_BUY_LABEL=
