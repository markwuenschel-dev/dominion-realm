@@ -0,0 +1,73 @@
+'use client';
+
+import { useEffect } from 'react';
+import '@/styles/reading.css';
+
+/**
+ * Route error boundary (App Router `error.tsx`). Must be a Client Component and
+ * receives the thrown error plus a `reset()` to retry the segment. Renders a
+ * branded fallback (reading layout) instead of the bare Next.js error screen,
+ * and logs the error so it surfaces in the Railway logs / a future error
+ * reporter. A global, layout-level failure is handled by `global-error.tsx`.
+ */
+export default function Error({
+  error,
+  reset,
+}: {
+  error: Error & { digest?: string };
+  reset: () => void;
+}) {
+  useEffect(() => {
+    // Surfaces in server/browser logs; swap for a real reporter (Sentry, …) later.
+    console.error(error);
+  }, [error]);
+
+  return (
+    <>
+      <div className="grain" />
+      <div className="vignette" />
+      <div className="reading">
+        <header className="reading-top">
+          <a className="reading-top__home" href="/">
+            ← The Dominion <em>Realm</em>
+          </a>
+          <nav className="reading-top__nav">
+            <a href="/read">The Reading</a>
+            <a href="/codex">Codex</a>
+            <a href="/journal">Journal</a>
+            <a href="/eyes">The Eyes</a>
+          </nav>
+        </header>
+        <main className="reading-wrap">
+          <article className="reading-article">
+            <span className="reading-article__kicker">Something broke</span>
+            <h1 className="reading-article__title">The interface lost the signal</h1>
+            <p className="reading-article__summary">
+              An unexpected error interrupted this page. The fault is on our side of the Realm, not
+              yours.
+            </p>
+            <div className="reading-article__rule" />
+
+            <div className="reading-prose">
+              <p>
+                Try again — the segment may recover. If it keeps happening, step back to the home
+                page and pick the path up from there.
+              </p>
+            </div>
+
+            <p className="reading-prose">
+              <button type="button" className="reading-back" onClick={() => reset()}>
+                ↻ Try again
+              </button>
+            </p>
+
+            <a className="reading-back" href="/">
+              ← Back to The Dominion Realm
+            </a>
+          </article>
+        </main>
+        <footer className="reading-footer">The Dominion Realm — Realmwalkers · Book One</footer>
+      </div>
+    </>
+  );
+}
