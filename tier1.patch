+            <nav className="reading-prose" aria-label="Where to go next">
+              <p>
+                <a href="/codex">Browse the World Codex</a> ·{' '}
+                <a href="/read">Read the opening pages</a> ·{' '}
+                <a href="/journal">The Author Journal</a>
+              </p>
+            </nav>
+
+            <a className="reading-back" href="/">
+              ← Back to The Dominion Realm
+            </a>
+          </article>
+        </main>
+        <footer className="reading-footer">The Dominion Realm — Realmwalkers · Book One</footer>
+      </div>
+    </>
+  );
+}
