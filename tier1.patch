@@ -0,0 +1,21 @@
+import type { MetadataRoute } from 'next';
+
+/**
+ * robots.txt (App Router `robots.ts`, served at /robots.txt). Allows general
+ * crawling, disallows the CMS + its OAuth endpoint (no SEO value, and not for
+ * public indexing), and points crawlers at the sitemap. Base origin mirrors
+ * sitemap.ts / rss.xml: NEXT_PUBLIC_SITE_URL with the canonical fallback.
+ */
+
+const SITE = (process.env.NEXT_PUBLIC_SITE_URL ?? 'https://dominionrealm.com').replace(/\/$/, '');
+
+export default function robots(): MetadataRoute.Robots {
+  return {
+    rules: {
+      userAgent: '*',
+      allow: '/',
+      disallow: ['/keystatic', '/api/'],
+    },
+    sitemap: `${SITE}/sitemap.xml`,
+  };
+}
diff --git a/src/app/sitemap.ts b/src/app/sitemap.ts
new file mode 100644
index 0000000..5da9452
--- /dev/null
+++ b/src/app/sitemap.ts
@@ -0,0 +1,59 @@
+import type { MetadataRoute } from 'next';
+import { getCodexEntries, codexUrl } from '@/lib/codex';
+import { getJournalPosts, journalUrl } from '@/lib/journal';
+import { getReadingEntries, readingUrl } from '@/lib/reading';
+
+/**
+ * XML sitemap (App Router `sitemap.ts`, served at /sitemap.xml). Enumerates the
+ * static routes plus every published codex/journal/reading entry via the same
+ * loaders + URL helpers the pages use, so the map can never drift from what is
+ * actually routable. Loaders draft-filter in prod, so drafts never leak here.
+ *
+ * The base origin mirrors rss.xml/route.ts: NEXT_PUBLIC_SITE_URL with the
+ * canonical domain as the fallback, trailing slash stripped.
+ */
+
+const SITE = (process.env.NEXT_PUBLIC_SITE_URL ?? 'https://dominionrealm.com').replace(/\/$/, '');
+
+/** Standalone, hand-maintained routes (the homepage and the page-level routes
+ *  registered in src/lib/site.ts). `/interface` is intentionally excluded until
+ *  it is flagged `ready` in NAV_PAGES. */
+const STATIC_PATHS = [
+  '/',
+  '/codex',
+  '/read',
+  '/journal',
+  '/map',
+  '/relationships',
+  '/eyes',
+  '/about',
+];
+
+export default function sitemap(): MetadataRoute.Sitemap {
+  const staticEntries: MetadataRoute.Sitemap = STATIC_PATHS.map((path) => ({
+    url: `${SITE}${path}`,
+    changeFrequency: 'monthly',
+    priority: path === '/' ? 1 : 0.7,
+  }));
+
+  const codexEntries: MetadataRoute.Sitemap = getCodexEntries().map((entry) => ({
+    url: `${SITE}${codexUrl(entry.collection, entry.id)}`,
+    changeFrequency: 'monthly',
+    priority: 0.5,
+  }));
+
+  const journalEntries: MetadataRoute.Sitemap = getJournalPosts().map((post) => ({
+    url: `${SITE}${journalUrl(post.id)}`,
+    lastModified: post.data.updatedDate ?? post.data.pubDate,
+    changeFrequency: 'yearly',
+    priority: 0.5,
+  }));
+
+  const readingEntries: MetadataRoute.Sitemap = getReadingEntries().map((entry) => ({
+    url: `${SITE}${readingUrl(entry.id)}`,
+    changeFrequency: 'yearly',
+    priority: 0.6,
+  }));
+
+  return [...staticEntries, ...codexEntries, ...journalEntries, ...readingEntries];
+}
